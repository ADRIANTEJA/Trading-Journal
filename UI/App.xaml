<Application x:Class="UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UI.Views"
             xmlns:viewModels="clr-namespace:MainModule.ViewModels;assembly=MainModule">

    <Application.Resources>
        <DataTemplate DataType="{x:Type TypeName=viewModels:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type TypeName=viewModels:AccountViewModel}">
            <views:AccountView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type TypeName=viewModels:StrategyViewModel}">
            <views:StrategyView/>
        </DataTemplate>
    </Application.Resources>
</Application>
