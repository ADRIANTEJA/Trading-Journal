<Window x:Class="UI.Windows.EditTradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows"
        xmlns:calculatorButtons="clr-namespace:UI.Controls.Buttons.CalculatorWindow"
        xmlns:commonButtons="clr-namespace:UI.Controls.Buttons.Common"
        xmlns:mainWindowButtons="clr-namespace:UI.Controls.Buttons.MainWindow"
        xmlns:textBoxes="clr-namespace:UI.Controls.TextBoxes"
        mc:Ignorable="d"
        Title="Edit Trade" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Effect="{StaticResource window_drop_shadow}"
        Height="625" 
        Width="500">

    <Border Background="{DynamicResource theme_background_brush}"
            BorderBrush="{StaticResource green_brush}"
            BorderThickness="1"
            CornerRadius="2">

        <Grid Margin="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid MouseDown="DragMoveHandler">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Edit Trade"
                           VerticalAlignment="Center"
                           Style="{StaticResource base_textblock_style}" 
                           Margin="64,0,0,0"/>

                <mainWindowButtons:QuitButton Grid.Column="2" 
                                              Click="CloseWindowHandler"/>

                <mainWindowButtons:MinimizeButton Grid.Column="1"
                                                  Click="MinimizeWindowHandler"/>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource control_wrapper_border_style}"
                    Margin="5">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Margin="5">
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Volume"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>
                            <textBoxes:PlaceHolderTextBox x:Name="volume_field"
                                                          Grid.Row="1"
                                                          Text="{Binding Path=SelectedTrade.Volume, Mode=OneWay}"
                                                          PlaceHolder=""
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>

                            <TextBlock Text="Open price"
                                       Grid.Row="2"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>
                            <textBoxes:PlaceHolderTextBox x:Name="open_price_field"
                                                          Grid.Row="3"
                                                          Text="{Binding Path=SelectedTrade.OpenPrice, Mode=OneWay}"
                                                          PlaceHolder=""
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>

                            <TextBlock Text="Close price"
                                       Grid.Row="4"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>
                            <textBoxes:PlaceHolderTextBox x:Name="close_price_field"
                                                          Grid.Row="5"
                                                          Text="{Binding Path=SelectedTrade.ClosePrice, Mode=OneWay,
                                                                 Converter={StaticResource zero_to_empty_string_converter}}"
                                                          PlaceHolder=""
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>

                            <TextBlock Text="Swap"
                                       Grid.Row="6"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>
                            <textBoxes:PlaceHolderTextBox x:Name="swap_field"
                                                          Grid.Row="7"
                                                          Text="{Binding Path=SelectedTrade.Swap, Mode=OneWay,
                                                                 Converter={StaticResource zero_to_empty_string_converter}}"
                                                          PlaceHolder=""
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>

                            <TextBlock Text="Spread"
                                       Grid.Row="8"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>
                            <textBoxes:PlaceHolderTextBox x:Name="spread_field"
                                                          Grid.Row="9"
                                                          Text="{Binding Path=SelectedTrade.Spread, Mode=OneWay,
                                                                 Converter={StaticResource zero_to_empty_string_converter}}"
                                                          PlaceHolder=""
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>

                            <TextBlock Text="Commissions"
                                       Grid.Row="10"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>
                            <textBoxes:PlaceHolderTextBox x:Name="commissions_field"
                                                          Grid.Row="11"
                                                          Text="{Binding Path=SelectedTrade.Commission, Mode=OneWay,
                                                                 Converter={StaticResource zero_to_empty_string_converter}}"
                                                          PlaceHolder=""
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>

                            <TextBlock Text="Other costs"
                                       Grid.Row="12"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>
                            <textBoxes:PlaceHolderTextBox x:Name="other_costs_field"
                                                          Grid.Row="13"
                                                          Text="{Binding Path=SelectedTrade.OtherCosts, Mode=OneWay,
                                                                 Converter={StaticResource zero_to_empty_string_converter}}"
                                                          PlaceHolder=""
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>

                            <TextBlock Text="Take profit"
                                       Grid.Row="14"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>
                            <textBoxes:PlaceHolderTextBox x:Name="take_profit_field"
                                                          Grid.Row="15"
                                                          Text="{Binding Path=SelectedTrade.TakeProfit, Mode=OneWay,
                                                                 Converter={StaticResource zero_to_empty_string_converter}}"
                                                          PlaceHolder=""
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>

                            <TextBlock Text="Stop Loss"
                                       Grid.Row="16"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>
                            <textBoxes:PlaceHolderTextBox x:Name="stop_loss_field"
                                                          Grid.Row="17"
                                                          Text="{Binding Path=SelectedTrade.StopLoss, Mode=OneWay,
                                                                 Converter={StaticResource zero_to_empty_string_converter}}"
                                                          PlaceHolder=""
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>

                            <TextBlock Text="Open date"
                                       Grid.Row="18"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>

                            <DatePicker x:Name="open_date_field"
                                        Grid.Row="19"
                                        SelectedDate="{Binding Path=SelectedTrade.OpenDate, Mode=OneWay,
                                                       Converter={StaticResource date_picker_date_to_ticks_converter}}"
                                        Tag=""
                                        Style="{StaticResource base_date_picker_style}"
                                        Margin="0,0,5,5" 
                                        Loaded="OnOpenDateFieldLoaded"/>

                            <TextBlock Text="Close date"
                                       Grid.Row="20"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left" 
                                       Margin="5,0,0,0"/>
                            <DatePicker x:Name="close_date_field"
                                        Grid.Row="21"
                                        SelectedDate="{Binding Path=SelectedTrade.CloseDate, Mode=OneWay,
                                                       Converter={StaticResource date_picker_date_to_ticks_converter}}"
                                        Tag=""
                                        Style="{StaticResource base_date_picker_style}"
                                        Margin="0,0,5,5" 
                                        Loaded="OnCloseDateFieldLoaded"/>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="Notes"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource base_textblock_style}"/>

                        <TextBox Name="notes_field"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding Path=SelectedTrade.Notes, Mode=TwoWay}"
                                 Style="{StaticResource base_text_box_style}"
                                 KeyDown="JumpToNextFieldHandler"
                                 Margin="5"/>

                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="Mistakes"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource base_textblock_style}"/>

                        <TextBox x:Name="mistakes_field"
                                 Grid.Row="3"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding Path=SelectedTrade.Mistakes, Mode=TwoWay}"
                                 Style="{StaticResource base_text_box_style}"
                                 Margin="5"/>

                        <TextBlock x:Name="selected_asset_textblock"
                                   Grid.ColumnSpan="2"
                                   Grid.Row="7"
                                   Style="{StaticResource base_textblock_style}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock x:Name="input_error_textblock"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource error_red_brush}"
                               Style="{StaticResource base_textblock_style}"/>

                    <commonButtons:SaveButton x:Name="edit_trade_button"
                                             Grid.Row="3"
                                             Grid.ColumnSpan="2" 
                                             Margin="200,5,200,5" 
                                             Click="EditTradeClickHandler"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
