<Window x:Class="UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mainWindowButtons="clr-namespace:UI.Controls.Buttons.MainWindow"
        xmlns:mainWindowSliders="clr-namespace:UI.Controls.Sliders.MainWindow"
        mc:Ignorable="d"
        Title="Asset Ops"
        x:Name="main_window"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="Transparent"
        MinHeight="810"
        MinWidth="1440"
        ResizeMode="CanResizeWithGrip"
        d:DesignHeight="1080"
        d:DesignWidth="1920"
        Loaded="OnWindowLoadedHandler" 
        Effect="{StaticResource window_drop_shadow}">

    <Window.Resources>
        <Storyboard x:Key="show_slide_settings_menu_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="settings_slide_menu" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="-1964.377">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="settings_slide_menu" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="settings_slide_menu" Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="hide_slide_settings_menu_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="settings_slide_menu" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="settings_slide_menu" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="settings_slide_menu" Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="show_theme_options_storyboard">
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="theme_options" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                <EasingThicknessKeyFrame KeyTime="00:00:00.3000000" Value="5,43,5,823">
                    <EasingThicknessKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingThicknessKeyFrame.EasingFunction>
                </EasingThicknessKeyFrame>
            </ThicknessAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="hide_theme_options_storyboard">
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="theme_options" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                <EasingThicknessKeyFrame KeyTime="00:00:00.3000000" Value="5,5,5,861">
                    <EasingThicknessKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingThicknessKeyFrame.EasingFunction>
                </EasingThicknessKeyFrame>
            </ThicknessAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    
    <Border Background="{DynamicResource theme_background_brush}"
            BorderBrush="{StaticResource green_brush}"
            BorderThickness="1"
            CornerRadius="2"
            Margin="5,5,5,5">

        <Grid Margin="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource green_brush}">

                <Grid MouseDown="DragMoveHandler"
                      Background="Transparent">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="app_icon"
                           Margin="3"
                           Source="{StaticResource application_logo_icon}"/>

                    <TextBlock x:Name="app_name"
                               Grid.Column="1"
                               Text="{StaticResource application_name}"
                               Style="{StaticResource base_textblock_style}"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="{StaticResource green_brush}"
                               FontWeight="DemiBold"
                               Margin="0,0,1684,0"/>

                    <mainWindowButtons:MinimizeButton Grid.Column="2"
                                                      Click="MinimizeWindowHandler"/>
                    <mainWindowButtons:ResizeButton x:Name="resize_button"
                                                    Grid.Column="3"
                                                    Click="ResizeMainWindowHandler"/>
                    <mainWindowButtons:QuitButton Grid.Column="4"
                                                  Click="CloseProgramHandler"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Background="Transparent">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="164"/>
                    <ColumnDefinition Width="370*"/>
                    <ColumnDefinition Width="1181*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="17"/>
                </Grid.ColumnDefinitions>

                <mainWindowButtons:PortfolioButton Grid.Column="6"
                                                   Command="{Binding Path=NavigateToPortfolioCommand}"
                                                   Margin="0,2,0,8"/>

                <mainWindowButtons:CalculatorButton Grid.Column="7"
                                                    Margin="0,2,0,8" 
                                                    Click="OpenCalculatorWindowHandler"/>

                <mainWindowButtons:SettingsButton Grid.Column="8"
                                                  Grid.ColumnSpan="2"
                                                  Click="ShowSettingsSliderHandler"
                                                  Margin="0,2,0,8"/>

                <mainWindowButtons:HomeNavigationButton x:Name="home_button"
                                                        Command="{Binding Path=NavigateToHomeCommand}"
                                                        Margin="5,2,5,8" 
                                                        Click="HoldNavButtonHighlightHandler"/>
                <mainWindowButtons:NavigationButton x:Name="account_button"
                                                    Command="{Binding Path=NavigateToAccountCommand}"
                                                    Content="{DynamicResource main_window_account_button}"
                                                    Grid.Column="1" 
                                                    Margin="5,2,5,8" 
                                                    Click="HoldNavButtonHighlightHandler"/>
                <mainWindowButtons:NavigationButton x:Name="strategy_button"
                                                    Command="{Binding Path=NavigateToStrategyCommand}"
                                                    Content="{DynamicResource main_window_strategy_button}"
                                                    Grid.Column="2" 
                                                    Margin="5,2,5,8" 
                                                    Click="HoldNavButtonHighlightHandler"/>
                <mainWindowButtons:NavigationButton x:Name="add_trade_button"
                                                    Command="{Binding Path=NavigateToAddTradeCommand}"
                                                    Content="{DynamicResource main_window_add_trade_button}"
                                                    Grid.Column="3" 
                                                    Margin="5,2,5,8"/>
            </Grid>

            <Grid x:Name="settings_slide_menu"
                  Grid.Column="7"
                  Grid.Row="1"
                  Grid.RowSpan="3" 
                  Margin="1967,0,-1967,-3" 
                  RenderTransformOrigin="0.5,0.5">

                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="17*"/>
                    <RowDefinition Height="1061*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="quit_slide_menu_invisible_button"
                        Opacity="0" 
                        Grid.RowSpan="2" 
                        Click="HideSettingsSliderHandler"/>

                <Border Grid.Column="1"
                        Grid.RowSpan="2"
                        Background="{DynamicResource theme_background_brush}" 
                        BorderBrush="{StaticResource green_brush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Margin="5,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="37"/>
                            <RowDefinition Height="37"/>
                            <RowDefinition Height="37"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="settings_menu_header"
                                   Grid.ColumnSpan="2"
                                   Text="{DynamicResource main_window_settings_menu_header}"
                                   Style="{StaticResource base_textblock_style}"
                                   FontSize="16" 
                                   Margin="5,5,5,0"/>

                        <mainWindowButtons:SelectLanguageButton Grid.Row="3"
                                                                Grid.ColumnSpan="2" 
                                                                Margin="7,5,3,0"
                                                                Command="{Binding Path=NavigateToSelectLanguageCommand}"/>


                        <mainWindowSliders:FontSizeSlider x:Name="font_size_options"
                                                          Grid.Row="2"
                                                          Grid.ColumnSpan="2"
                                                          Margin="20,5,10,0"/>

                        <mainWindowButtons:ThemeOptions x:Name="theme_options"
                                                        Grid.Row="4"
                                                        Grid.ColumnSpan="2"
                                                        ClipToBounds="True"
                                                        VerticalAlignment="Top"
                                                        Margin="5,5,5,0" 
                                                        Height="32"/>


                        <mainWindowButtons:SwitchThemeButton x:Name="switch_theme_button"
                                                             Grid.Row="4"
                                                             Grid.ColumnSpan="2"
                                                             VerticalAlignment="Top"
                                                             Click="ShowThemeOptionsHandler" 
                                                             Margin="3,5,3,0" 
                                                             Height="32" />

                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource green_brush}"
                    Margin="-1,-3,-1,-1" 
                    Panel.ZIndex="-1">
                <ContentControl x:Name="navigation_panel"
                                Content="{Binding Path=Navigation.CurrentView}" 
                                Loaded="OnNaviagtionPanelLoadedHandler"/>
            </Border>

        </Grid>
    </Border>
</Window>
