<Window x:Class="UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="True"
        MinHeight="1080"
        MinWidth="1920">

    <Border>
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid MouseDown="DragMoveHandler"
                  Background="Green"
                  Margin="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="minimize_button"
                Background="Black"
                Foreground="white"
                Content="m"
                Grid.Column="2" Click="MinimizeMainWindowHandler"/>
                <Button x:Name="resize_button"
                Background="Black"
Foreground="white" Grid.Column="3"
                    Content="r" Click="ResizeMainWindowHandler"/>
                <Button x:Name="quit_button"
                Background="Red"
                    Grid.Column="4"
                    Content="q"
Foreground="white" Click="CloseProgramHandler"/>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="home_button"
                        Command="{Binding Path=NavigateToHomeCommand}"
                Background="blue"
                    Content="Home"
Foreground="white"/>
                <Button x:Name="account_button"
                        Command="{Binding Path=NavigateToAccountCommand}"
                Background="Green"
                    Content="Account"
                    Grid.Column="1"
Foreground="white"/>
                <Button x:Name="strategy_button"
                        Command="{Binding Path=NavigateToStrategyCommand}"
                Background="cyan"
                    Content="Strategy"
                    Grid.Column="2"
Foreground="white"/>
                <Button x:Name="filter_button"
                        Command="{Binding Path=NavigateToAddTradeCommand}"
                Background="BlueViolet"
                    Content="Add Trade"
                    Grid.Column="3"
Foreground="white"/>
            </Grid>

            <ContentControl Grid.Row="2"
                            Content="{Binding Path=Navigation.CurrentView}"
                            Background="Black"
                            Margin="1">
                
            </ContentControl>
        </Grid>
    </Border>
</Window>
