<Window x:Class="UI.Windows.SelectLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mainWindowButtons="clr-namespace:UI.Controls.Buttons.MainWindow"
        WindowStyle="None"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="Transparent"
        Title="{DynamicResource select_language_window_window_header}" 
        ResizeMode="NoResize"
        WindowState="Normal"
        Height="300" 
        Width="450"
        Effect="{StaticResource window_drop_shadow}" 
        Loaded="ReflectSelectedLanguageHandler">
    
    <Border Background="{DynamicResource theme_background_brush}"
            BorderBrush="{StaticResource green_brush}"
            BorderThickness="1"
            CornerRadius="2">

        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource green_brush}">
                
                <Grid MouseDown="DragMoveHandler">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="window_header"
                               Text="{DynamicResource select_language_window_window_header}"
                               Style="{StaticResource base_textblock_style}"
                               FontSize="18" 
                               Margin="32,0,0,0"/>

                    <mainWindowButtons:QuitButton Grid.Column="1" 
                                                  Click="CloseWindowHandler"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <mainWindowButtons:LanguageRadioButton x:Name="English"
                                                       Tag="English" 
                                                       Margin="10,16,55,16"/>
                <mainWindowButtons:LanguageRadioButton x:Name="Spanish"
                                                       Grid.Column="1"
                                                       Tag="Español" 
                                                       Margin="10,16,55,16"/>
                <mainWindowButtons:LanguageRadioButton x:Name="Chinese"
                                                       Grid.Column="2"
                                                       Tag="中国人" 
                                                       Margin="10,16,55,16"/>
                <mainWindowButtons:LanguageRadioButton x:Name="Japanese"
                                                       Grid.Row="1"
                                                       Tag="日本語" 
                                                       Margin="10,16,55,16"/>
                <mainWindowButtons:LanguageRadioButton x:Name="Russian"
                                                       Grid.Column="1"
                                                       Grid.Row="1"
                                                       Tag="Русский" 
                                                       Margin="10,16,55,16"/>
                <mainWindowButtons:LanguageRadioButton x:Name="German"
                                                       Grid.Column="2"
                                                       Grid.Row="1"
                                                       Tag="Deutsch" 
                                                       Margin="10,16,55,16"/>
                <mainWindowButtons:LanguageRadioButton x:Name="Portuguese"
                                                       Grid.Row="2"
                                                       Tag="Português" 
                                                       Margin="10,16,55,16"/>
                <mainWindowButtons:LanguageRadioButton x:Name="French"
                                                       Grid.Column="1"
                                                       Grid.Row="2"
                                                       Tag="Français" 
                                                       Margin="10,16,55,16"/>
                <mainWindowButtons:LanguageRadioButton x:Name="Italian"
                                                       Grid.Column="2"
                                                       Grid.Row="2"
                                                       Tag="Italiano" 
                                                       Margin="10,16,55,16"/>

                <Image Source="{StaticResource english_icon}" 
                       Margin="95,20,15,20"/>
                <Image Grid.Column="2"
                       Source="{StaticResource chinese_icon}"
                       Margin="95,20,15,20"/>
                <Image Grid.Row="1"
                       Source="{StaticResource japanese_icon}"
                       Margin="95,20,15,20"/>
                <Image Grid.Column="1"
                       Grid.Row="1"
                       Source="{StaticResource russian_icon}"
                       Margin="95,20,15,20"/>
                <Image Grid.Column="2"
                       Grid.Row="1"
                       Source="{StaticResource german_icon}"
                       Margin="95,20,15,20"/>
                <Image Grid.Row="2"
                       Source="{StaticResource portuguese_icon}"
                       Margin="95,20,15,20"/>
                <Image Grid.Column="1"
                       Grid.Row="2"
                       Source="{StaticResource french_icon}"
                       Margin="95,20,15,20"/>
                <Image Grid.Column="1"
                       Source="{StaticResource spanish_icon}"
                       Margin="95,20,15,20"/>
                <Image Grid.Column="2"
                       Grid.Row="2"
                       Source="{StaticResource italian_icon}"
                       Margin="95,20,15,20"/>
            </Grid>
        </Grid>
    </Border>
</Window>
