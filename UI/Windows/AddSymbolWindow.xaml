<Window x:Class="UI.Windows.AddSymbolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows"
        xmlns:mainWindowButtons="clr-namespace:UI.Controls.Buttons.MainWindow"
        xmlns:textBoxes="clr-namespace:UI.Controls.TextBoxes"
        xmlns:customScrollViewers="clr-namespace:UI.Controls.ScrollViewers.Custom"
        xmlns:portfolioWindowButtons="clr-namespace:UI.Controls.Buttons.PortfolioWindow"
        mc:Ignorable="d"
        Title="Add symbol"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="CanMinimize"
        Height="260" 
        Width="300">

    <Window.Resources>
        <Storyboard x:Key="show_asset_types_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="asset_type_selector" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="110">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="hide_asset_types_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="asset_type_selector" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    
    <Border Background="{DynamicResource theme_background_brush}"
            BorderBrush="{StaticResource green_brush}"
            BorderThickness="1"
            CornerRadius="2">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid MouseDown="DragMoveHandler">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Add symbol"
                           VerticalAlignment="Center"
                           Style="{StaticResource base_textblock_style}" 
                           Margin="64,0,0,0"/>

                <mainWindowButtons:MinimizeButton Grid.Column="1"
                                                  Click="MinimizeWindowHandler"/>
                <mainWindowButtons:QuitButton Grid.Column="2"
                                              Click="CloseWindowHandler"/>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource control_wrapper_border_style}"
                    Margin="5">

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="43"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="3"
                               Text="Pair"
                               VerticalAlignment="Center"
                               Style="{StaticResource base_textblock_style}"/>

                    <TextBox x:Name="sold_asset_field"
                             Grid.Row="1"
                             Text="{Binding Path=SoldAssetVM, Mode=OneWayToSource}"
                             TextWrapping="NoWrap"
                             TextAlignment="Center"
                             MaxLength="10"
                             Style="{StaticResource base_text_box_style}" 
                             Margin="80,5,5,5" 
                             KeyDown="JumpToNextFieldHandler" 
                             TextChanged="OnAssetPairChangedHandler"/>
                    <TextBox x:Name="buyed_asset_field"
                             Grid.Column="2"
                             Grid.Row="1"
                             Text="{Binding Path=BuyedAssetVM, Mode=OneWayToSource}"
                             TextWrapping="NoWrap"
                             TextAlignment="Center"
                             MaxLength="10"
                             Style="{StaticResource base_text_box_style}" 
                             Margin="5,5,80,5"
                             TextChanged="OnAssetPairChangedHandler"/>

                    <TextBlock Grid.Column="1"
                               Grid.Row="1"
                               Text="/"
                               VerticalAlignment="Center"
                               Style="{StaticResource base_textblock_style}" 
                               Margin="0,-20,0,-20"/>

                    <customScrollViewers:AssetTypeSelector x:Name="asset_type_selector"
                                                           Grid.ColumnSpan="3"
                                                           Grid.Row="2"
                                                           Grid.RowSpan="3"
                                                           Height="32"
                                                           Panel.ZIndex="1"
                                                           Margin="90,5,90,5"
                                                           MouseEnter="ShowAssetTypesHandler"
                                                           MouseLeave="HideAssetTypesHandler" 
                                                           Loaded="OnAssetTypeSelectorLoaded"/>

                    <TextBlock x:Name="input_error_textblock"
                               Grid.ColumnSpan="3"
                               Grid.Row="3"
                               Text="Error"
                               Foreground="{StaticResource error_red_brush}"
                               Visibility="Hidden"
                               VerticalAlignment="Center"
                               Style="{StaticResource base_textblock_style}"/>

                    <portfolioWindowButtons:AddSymbolButton x:Name="add_symbol_button"
                                                            Grid.ColumnSpan="3"
                                                            Grid.Row="4"
                                                            Margin="90,5,90,5" 
                                                            Click="AddSymbolClickHandler"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
