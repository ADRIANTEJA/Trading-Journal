<Window x:Class="UI.Windows.EditStrategyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows"
        xmlns:mainWindowButtons="clr-namespace:UI.Controls.Buttons.MainWindow"
        xmlns:textBoxes="clr-namespace:UI.Controls.TextBoxes"
        xmlns:customScrollViewers="clr-namespace:UI.Controls.ScrollViewers.Custom"
        xmlns:customButtons="clr-namespace:UI.Controls.Buttons.Common"
        mc:Ignorable="d"
        Title="Edit risk management plan" 
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="True"
        Background="Transparent"
        Effect="{StaticResource window_drop_shadow}"
        Height="420" 
        Width="500">


    <Border Background="{DynamicResource theme_background_brush}"
            BorderBrush="{StaticResource green_brush}"
            BorderThickness="1"
            CornerRadius="2">

        <Grid Margin="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid MouseDown="DragMoveHandler">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Add strategy"
                           VerticalAlignment="Center"
                           Style="{StaticResource base_textblock_style}" 
                           Margin="64,0,0,0"/>

                <mainWindowButtons:QuitButton Grid.Column="2" 
                                              Click="CloseWindowHandler"/>

                <mainWindowButtons:MinimizeButton Grid.Column="1"
                                                  Click="MinimizeWindowHandler"/>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource control_wrapper_border_style}"
                    Margin="5">

                <Grid Margin="5,5,5,5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Margin="0,10,0,0">
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Name"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left"/>
                            <textBoxes:PlaceHolderTextBox x:Name="name_field"
                                                          Grid.Row="1"
                                                          Text="{Binding Path=SelectedStrategy.Name, Mode=OneWay}"
                                                          PlaceHolder=""
                                                          Margin="0,0,10,10" 
                                                          KeyDown="JumpToNextFieldHandler" 
                                                          TextChanged="OnNameFieldChangedHandler"/>

                            <TextBlock Grid.Row="2"
                                       Text="Intermediary"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left"/>
                            <textBoxes:PlaceHolderTextBox x:Name="intermediary_field"
                                                          Grid.Row="3"
                                                          Text="{Binding Path=SelectedStrategy.Intermediary, Mode=OneWay}"
                                                          PlaceHolder=""
                                                          Margin="0,0,10,11"
                                                          KeyDown="JumpToNextFieldHandler"/>

                            <TextBlock Text="Risk reward ratio"
                                       Grid.Row="4"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left"/>
                            <textBoxes:PlaceHolderTextBox x:Name="risk_reward_ratio_field"
                                                          Grid.Row="5"
                                                          Text="{Binding Path=SelectedStrategy.RiskRewardRatio, Mode=OneWay}"
                                                          PlaceHolder=""
                                                          Margin="0,0,10,11"
                                                          TextChanged="ValidateNumericValueHandler"
                                                          KeyDown="JumpToNextFieldHandler"/>

                            <TextBlock Text="Max trade risk"
                                       Grid.Row="6"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left"/>
                            <textBoxes:PlaceHolderTextBox x:Name="max_trade_risk_field"
                                                          Grid.Row="7"
                                                          Text="{Binding Path=SelectedStrategy.MaxTradeRisk, Mode=OneWay}"
                                                          PlaceHolder=""
                                                          Margin="0,0,10,11"
                                                          TextChanged="ValidateNumericValueHandler"
                                                          KeyDown="JumpToNextFieldHandler"/>

                            <TextBlock Text="Daily goal"
                                       Grid.Row="8"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left"/>
                            <textBoxes:PlaceHolderTextBox x:Name="daily_goal_field"
                                                          Grid.Row="9"
                                                          Text="{Binding Path=SelectedStrategy.DailyGoal, Mode=OneWay}"
                                                          PlaceHolder=""
                                                          Margin="0,0,10,11"
                                                          TextChanged="ValidateNumericValueHandler"
                                                          KeyDown="JumpToNextFieldHandler"/>

                            <TextBlock Text="Max daily loss"
                                       Grid.Row="10"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left"/>
                            <textBoxes:PlaceHolderTextBox x:Name="max_daily_loss_field"
                                                          Grid.Row="11"
                                                          Text="{Binding Path=SelectedStrategy.MaxDailyLoss, Mode=OneWay}"
                                                          PlaceHolder=""
                                                          Margin="0,0,10,11"
                                                          TextChanged="ValidateNumericValueHandler"
                                                          KeyDown="JumpToNextFieldHandler"/>
                        </Grid>
                    </ScrollViewer>
                    

                    <Grid Grid.Column="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions >
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="180.8"/>
                        </Grid.RowDefinitions>



                        <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Text="Goal"
                               VerticalAlignment="Center"
                               Style="{StaticResource base_textblock_style}"/>

                        <TextBox x:Name="goal_field"
                             Grid.ColumnSpan="2"
                             Grid.Row="3"
                             Text="{Binding Path=SelectedStrategy.Goal}"
                             Style="{StaticResource base_text_box_style}" 
                             Margin="0,0,0,19"/>
                    </Grid>

                    <TextBlock x:Name="input_error_textblock"
                           Grid.ColumnSpan="2"
                           Grid.Row="1"
                           Text="{StaticResource add_strategy_window_duplicated_strategy_name_error}"
                           Foreground="{StaticResource error_red_brush}"
                           VerticalAlignment="Center"
                           Visibility="Hidden"
                           Style="{StaticResource base_textblock_style}"/>

                    <customButtons:SaveButton x:Name="add_strategy_button"
                                              Grid.Row="2"
                                              Grid.ColumnSpan="2" 
                                              Margin="200,0,200,0" 
                                              Click="EditStrategyClickHandler"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
