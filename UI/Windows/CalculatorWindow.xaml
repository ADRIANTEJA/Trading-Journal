<Window x:Class="UI.Windows.CalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mainWindowButtons="clr-namespace:UI.Controls.Buttons.MainWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        mc:Ignorable="d"
        Title="{DynamicResource calculator_window_window_header}" 
        Height="550" 
        Width="400"
        ResizeMode="NoResize"
        Effect="{StaticResource window_drop_shadow}" 
        Loaded="OnWindowLoadedHandler">

    <Border Background="{DynamicResource theme_background_brush}"
            BorderBrush="{StaticResource green_brush}"
            BorderThickness="1"
            CornerRadius="2">

        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="124*"/>
                    <ColumnDefinition Width="23*"/>
                    <ColumnDefinition Width="147*"/>
                </Grid.ColumnDefinitions>

                <mainWindowButtons:NavigationButton x:Name="roi_button"
                                                    Content="ROI"
                                                    Style="{StaticResource navigation_button_style}" 
                                                    Margin="80,8,5,8" 
                                                    Click="NavigateToROIViewHandler" 
                                                    Grid.ColumnSpan="2"/>
                <mainWindowButtons:NavigationButton x:Name="target_price_button"
                                                    Grid.Column="2"
                                                    Content="{DynamicResource calculator_window_target_price_button}"
                                                    Style="{StaticResource navigation_button_style}" 
                                                    Margin="5,8,80,8" 
                                                    Click="NavigateToTargetPriceViewHandler"/>
            </Grid>

            <Grid MouseDown="DragMoveHandler">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource calculator_window_window_header}"
                           VerticalAlignment="Center"
                           Style="{StaticResource base_textblock_style}" 
                           Margin="64,0,0,0"/>
                
                <mainWindowButtons:QuitButton Grid.Column="2" 
                                              Click="CloseWindowHandler"/>

                <mainWindowButtons:MinimizeButton Grid.Column="1"
                                                  Click="MinimizeWindowHandler"/>
            </Grid>

            <Frame x:Name="navigation_panel"
                   NavigationUIVisibility="Hidden"
                   Grid.Row="2"
                   Content="{Binding Navigation.CurrentView}"/>
        </Grid>
    </Border>
</Window>
