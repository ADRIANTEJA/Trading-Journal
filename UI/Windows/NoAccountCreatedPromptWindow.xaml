<Window x:Class="UI.Windows.NoAccountCreatedPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows"
        xmlns:mainWindowButtons="clr-namespace:UI.Controls.Buttons.MainWindow"
        xmlns:commonButtons="clr-namespace:UI.Controls.Buttons.Common"
        mc:Ignorable="d"
        Title="No account created" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="300"
        Height="200"
        ResizeMode="NoResize"
        Effect="{StaticResource window_drop_shadow}">

    <Border Background="{DynamicResource theme_background_brush}"
            BorderBrush="{StaticResource green_brush}"
            BorderThickness="1"
            CornerRadius="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="37"/>
            </Grid.RowDefinitions>

            <Grid MouseDown="DragMoveHandler"
                  Background="Transparent">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        CornerRadius="10"
                        Width="10"
                        Height="10" 
                        Margin="10,12,12,10"/>

                <Image Source="{StaticResource yellow_warning_icon}"
                       Width="12"
                       Height="12"
                       Margin="9,11,11,9"/>

                <mainWindowButtons:MinimizeButton Grid.Column="2"
                                                  Click="MinimizeWindowHandler"/>
                <mainWindowButtons:QuitButton Grid.Column="4"
                                              Click="CloseProgramHandler"/>
            </Grid>

            <TextBlock Text="you need to have at least one account created in order to add a trade"
                       Grid.Row="1"
                       TextWrapping="Wrap"
                       Style="{StaticResource base_textblock_style}"
                       VerticalAlignment="Top" 
                       Margin="15,10,15,0"/>

            <commonButtons:OKButton Grid.Row="2" 
                                    Click="OkButtonClickHandler"
                                    Width="100" 
                                    Margin="0,0,0,5"/>
        </Grid>
    </Border>
</Window>
