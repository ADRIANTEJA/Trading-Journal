<Window x:Class="UI.Windows.AddTradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mainWindowButtons="clr-namespace:UI.Controls.Buttons.MainWindow"
        xmlns:textBoxes="clr-namespace:UI.Controls.TextBoxes"
        xmlns:customScrollViewers="clr-namespace:UI.Controls.ScrollViewers.Custom"
        xmlns:calculatorButtons="clr-namespace:UI.Controls.Buttons.CalculatorWindow"
        xmlns:commonButtons="clr-namespace:UI.Controls.Buttons.Common"
        mc:Ignorable="d"
        Title="Add trade"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Height="600" 
        Width="500" 
        Loaded="OnAddTradeWindowLoaded">
    
    <Window.Resources>
        <Storyboard x:Key="show_asset_types_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="asset_type_selector" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="150">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="hide_asset_types_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="asset_type_selector" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="show_symbols_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="symbol_selector" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="150">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="hide_symbols_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="symbol_selector" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Border Background="{DynamicResource theme_background_brush}"
            BorderBrush="{StaticResource green_brush}"
            BorderThickness="1"
            CornerRadius="2">

        <Grid Margin="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid MouseDown="DragMoveHandler">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Add trade"
                           VerticalAlignment="Center"
                           Style="{StaticResource base_textblock_style}" 
                           Margin="64,0,0,0"/>

                <mainWindowButtons:QuitButton Grid.Column="2" 
                                              Click="CloseWindowHandler"/>

                <mainWindowButtons:MinimizeButton Grid.Column="1"
                                                  Click="MinimizeWindowHandler"/>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource control_wrapper_border_style}"
                    Margin="5">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Margin="5">
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <textBoxes:PlaceHolderTextBox x:Name="volume_field"
                                                          PlaceHolder="Volume"
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>
                            <textBoxes:PlaceHolderTextBox x:Name="open_price_field"
                                                          Grid.Row="1"
                                                          PlaceHolder="Open price"
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>
                            <textBoxes:PlaceHolderTextBox x:Name="close_price_field"
                                                          Grid.Row="2"
                                                          PlaceHolder="Close price"
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>
                            <textBoxes:PlaceHolderTextBox x:Name="trade_cost_field"
                                                          Grid.Row="3"
                                                          PlaceHolder="Trade cost"
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>
                            <textBoxes:PlaceHolderTextBox x:Name="swap_field"
                                                          Grid.Row="4"
                                                          PlaceHolder="Swap"
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>
                            <textBoxes:PlaceHolderTextBox x:Name="spread_field"
                                                          Grid.Row="5"
                                                          PlaceHolder="Spread"
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>
                            <textBoxes:PlaceHolderTextBox x:Name="commissions_field"
                                                          Grid.Row="6"
                                                          PlaceHolder="Commissions"
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>
                            <textBoxes:PlaceHolderTextBox x:Name="other_costs_field"
                                                          Grid.Row="7"
                                                          PlaceHolder="Other costs"
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>
                            <textBoxes:PlaceHolderTextBox x:Name="take_profit_field"
                                                          Grid.Row="8"
                                                          PlaceHolder="Take profit"
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>
                            <textBoxes:PlaceHolderTextBox x:Name="stop_loss_field"
                                                          Grid.Row="9"
                                                          PlaceHolder="Stop loss"
                                                          Margin="0,0,5,11"
                                                          KeyDown="JumpToNextFieldHandler"
                                                          TextChanged="ValidateNumericValueHandler"/>

                            <DatePicker x:Name="open_date_field"
                                        Grid.Row="10"
                                        Tag="Open date"
                                        Style="{StaticResource base_date_picker_style}"
                                        Margin="0,0,5,5" 
                                        Loaded="OnOpenDateFieldLoaded"/>

                            <DatePicker x:Name="close_date_field"
                                        Grid.Row="11"
                                        Tag="Close date"
                                        Style="{StaticResource base_date_picker_style}"
                                        Margin="0,0,5,5" 
                                        Loaded="OnCloseDateFieldLoaded"/>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource add_trade_window_asset_type_selector_header}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource base_textblock_style}"/>

                        <TextBlock Grid.Column="1"
                                   Text="Symbol"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource base_textblock_style}"/>

                        <customScrollViewers:AssetTypeSelector x:Name="asset_type_selector"
                                                               Grid.RowSpan="4"
                                                               Height="32"
                                                               Grid.Row="1"
                                                               Panel.ZIndex="1"
                                                               MouseEnter="ShowAssetTypesHandler"
                                                               MouseLeave="HideAssetTypesHandler" 
                                                               Margin="5,0,5,0" 
                                                               Loaded="OnAssetTypeSelectionChangedHandler"/>
                        <customScrollViewers:SymbolSelector x:Name="symbol_selector"
                                                            Height="32"
                                                            Grid.Column="1"
                                                            Grid.Row="1" 
                                                            Grid.RowSpan="4"
                                                            Panel.ZIndex="1"
                                                            MouseEnter="ShowSymbolsHandler" 
                                                            MouseLeave="HideSymbolsHandler" 
                                                            Margin="5,0,5,0"/>

                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="Notes"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource base_textblock_style}"/>

                        <TextBox Name="notes_field"
                                 Grid.Row="3"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding Path=NotesVM}"
                                 Style="{StaticResource base_text_box_style}"
                                 KeyDown="JumpToNextFieldHandler"
                                 Margin="5"/>

                        <TextBlock Grid.Row="4"
                                   Grid.ColumnSpan="2"
                                   Text="Mistakes"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource base_textblock_style}"/>

                        <TextBox x:Name="mistakes_field"
                                 Grid.Row="5"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding Path=MistakesVM}"
                                 Style="{StaticResource base_text_box_style}"
                                 Margin="5"/>

                        <calculatorButtons:LongButton x:Name="long_button"
                                                      Grid.Row="6" 
                                                      Margin="20,5,5,5" 
                                                      Loaded="OnLongButtonLoaded"
                                                      Click="LongOperationSelectionHandler"/>
                        <calculatorButtons:ShortButton x:Name="short_button"
                                                       Grid.Column="1"
                                                       Grid.Row="6" 
                                                       Margin="5,5,20,5"
                                                       Click="ShortOperationSelectionHandler"/>

                        <TextBlock x:Name="selected_asset_textblock"
                                   Grid.ColumnSpan="2"
                                   Grid.Row="5"
                                   Style="{StaticResource base_textblock_style}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock x:Name="input_error_textblock"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource error_red_brush}"
                               Style="{StaticResource base_textblock_style}"/>

                    <commonButtons:AddButton x:Name="add_trade_button"
                                             Grid.Row="2"
                                             Grid.ColumnSpan="2" 
                                             Margin="200,5,200,5" 
                                             Click="AddTradeClickHandler"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
