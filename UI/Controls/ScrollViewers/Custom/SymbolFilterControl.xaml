<Border x:Name="border" 
        x:Class="UI.Controls.ScrollViewers.Custom.SymbolFilterControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.ScrollViewers.Custom"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Style="{StaticResource highlightable_border_style}"
        Background="{DynamicResource theme_control_wrapper_background_brush}"
        Width="100"
        d:DesignHeight="32"
        d:DesignWidth="800">

    <Border.Resources>
        <Storyboard x:Key="expand_symbol_category_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="(FrameworkElement.Width)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="800">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="test">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="border1" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="100"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Border.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Style="{StaticResource expand_option_list_buttons_style}" 
                Click="ShowSymbolCategoryHandler"/>

        <Border x:Name="border1"
                Grid.Column="1"
                ClipToBounds="False"
                Style="{StaticResource highlightable_border_style}"
                Background="{StaticResource theme_control_wrapper_background_brush}"
                Height="32">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Crypto"
                   Style="{StaticResource base_textblock_style}"
                   VerticalAlignment="Center"/>

                    <Polygon Grid.Column="1"
                 Points="1,6,11,6,6,11" 
                 Fill="{StaticResource green_brush}" 
                 Margin="0,9,0,0"/>
                </Grid>

                <ListView x:Name="crypto_list_view"
              Grid.Row="1"
              Background="Transparent"
              BorderBrush="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              IsSynchronizedWithCurrentItem="True"
              Style="{StaticResource epander_option_list_items_style}">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                        Style="{StaticResource text_buttons_style}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.Items>
                        <system:String>a</system:String>
                        <system:String>a</system:String>
                        <system:String>a</system:String>
                    </ListView.Items>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource highlightable_border_style}"
                Background="{StaticResource theme_control_wrapper_background_brush}">

            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Forex"
                   Style="{StaticResource base_textblock_style}"
                   VerticalAlignment="Center"/>

                    <Polygon Grid.Column="1"
                 Points="1,6,11,6,6,11" 
                 Fill="{StaticResource green_brush}" 
                 Margin="0,9,0,0"/>
                </Grid>

                <ListView x:Name="forex_list_view"
              Grid.Row="1"
              Background="Transparent"
              BorderBrush="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              IsSynchronizedWithCurrentItem="True"
              Style="{StaticResource epander_option_list_items_style}">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                        Style="{StaticResource text_buttons_style}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.Items>
                    </ListView.Items>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Column="3"
                Style="{StaticResource highlightable_border_style}"
                Background="{StaticResource theme_control_wrapper_background_brush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Indices"
                   Style="{StaticResource base_textblock_style}"
                   VerticalAlignment="Center"/>

                    <Polygon Grid.Column="1"
                 Points="1,6,11,6,6,11" 
                 Fill="{StaticResource green_brush}" 
                 Margin="0,9,0,0"/>
                </Grid>

                <ListView x:Name="indices_list_view"
              Grid.Row="1"
              Background="Transparent"
              BorderBrush="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              IsSynchronizedWithCurrentItem="True"
              Style="{StaticResource epander_option_list_items_style}">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                        Style="{StaticResource text_buttons_style}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.Items>
                    </ListView.Items>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Column="4"
                Style="{StaticResource highlightable_border_style}"
                Background="{StaticResource theme_control_wrapper_background_brush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ETFs"
                   Style="{StaticResource base_textblock_style}"
                   VerticalAlignment="Center"/>

                    <Polygon Grid.Column="1"
                 Points="1,6,11,6,6,11" 
                 Fill="{StaticResource green_brush}" 
                 Margin="0,9,0,0"/>
                </Grid>

                <ListView x:Name="etf_list_view"
              Grid.Row="1"
              Background="Transparent"
              BorderBrush="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              IsSynchronizedWithCurrentItem="True"
              Style="{StaticResource epander_option_list_items_style}">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                        Style="{StaticResource text_buttons_style}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.Items>
                    </ListView.Items>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Column="5"
                Style="{StaticResource highlightable_border_style}"
                Background="{StaticResource theme_control_wrapper_background_brush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Stocks"
                   Style="{StaticResource base_textblock_style}"
                   VerticalAlignment="Center"/>

                    <Polygon Grid.Column="1"
                 Points="1,6,11,6,6,11" 
                 Fill="{StaticResource green_brush}" 
                 Margin="0,9,0,0"/>
                </Grid>

                <ListView x:Name="stocks_list_view"
              Grid.Row="1"
              Background="Transparent"
              BorderBrush="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              IsSynchronizedWithCurrentItem="True"
              Style="{StaticResource epander_option_list_items_style}">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
        Style="{StaticResource text_buttons_style}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.Items>
                    </ListView.Items>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Column="6"
                Style="{StaticResource highlightable_border_style}"
                Background="{StaticResource theme_control_wrapper_background_brush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Commodities"
                   Style="{StaticResource base_textblock_style}"
                   VerticalAlignment="Center"/>

                    <Polygon Grid.Column="1"
                 Points="1,6,11,6,6,11" 
                 Fill="{StaticResource green_brush}" 
                 Margin="0,9,0,0"/>
                </Grid>

                <ListView x:Name="commodities_list_view"
              Grid.Row="1"
              Background="Transparent"
              BorderBrush="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              IsSynchronizedWithCurrentItem="True"
              Style="{StaticResource epander_option_list_items_style}">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                        Style="{StaticResource text_buttons_style}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.Items>
                    </ListView.Items>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Border>
