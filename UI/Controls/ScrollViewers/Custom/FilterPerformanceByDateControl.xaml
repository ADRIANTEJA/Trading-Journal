<Border x:Class="UI.Controls.ScrollViewers.Custom.FilterPerformanceByDateControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:UI.Controls.ScrollViewers.Custom"
        Background="{DynamicResource theme_control_wrapper_background_brush}"
        Style="{StaticResource highlightable_border_style}"
        mc:Ignorable="d"
        d:DesignWidth="115">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Filter by date"
                       Style="{StaticResource base_textblock_style}"
                       VerticalAlignment="Center"/>

            <Polygon x:Name="toggle_icon"
                     Grid.Column="1"
                     Points="1,6 11,6 6,11" 
                     Fill="{StaticResource green_brush}" 
                     Margin="0,9,0,0"/>
        </Grid>

        <ListView x:Name="options_list_view"
                  Grid.Row="1"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  IsSynchronizedWithCurrentItem="True"
                  Style="{StaticResource epander_option_list_items_style}">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}"
                            Style="{StaticResource text_buttons_style}"/>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Items>
                <system:String>January</system:String>
                <system:String>February</system:String>
                <system:String>March</system:String>
                <system:String>April</system:String>
                <system:String>May</system:String>
                <system:String>June</system:String>
                <system:String>July</system:String>
                <system:String>August</system:String>
                <system:String>September</system:String>
                <system:String>October</system:String>
                <system:String>November</system:String>
                <system:String>December</system:String>
                <system:String>January</system:String>
                <system:String>February</system:String>
                <system:String>March</system:String>
                <system:String>April</system:String>
                <system:String>May</system:String>
                <system:String>June</system:String>
                <system:String>July</system:String>
                <system:String>August</system:String>
                <system:String>September</system:String>
                <system:String>October</system:String>
                <system:String>November</system:String>
                <system:String>December</system:String>
            </ListView.Items>
        </ListView>
    </Grid>
</Border>
