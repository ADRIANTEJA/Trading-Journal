<Border x:Class="UI.Controls.ScrollViewers.Custom.TextBlockListViewItem"
        x:Name="container"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.ScrollViewers.Custom"
        Style="{StaticResource selectable_container_style}"
        Cursor="Hand"
        CornerRadius="3"
        mc:Ignorable="d" 
        Height="32" 
        d:DesignWidth="80">

    <TextBlock Text="{Binding Path=Tag, ElementName=container}"
               VerticalAlignment="Center"
               Style="{StaticResource base_textblock_style}"/>  
</Border>
