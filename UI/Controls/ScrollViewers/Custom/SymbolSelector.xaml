<Border x:Class="UI.Controls.ScrollViewers.Custom.SymbolSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.ScrollViewers.Custom"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Background="{DynamicResource theme_control_wrapper_background_brush}"
        Style="{StaticResource selector_border_style}"
        Height="32"
        d:DesignWidth="100" 
        Loaded="OnSymbolSelectorLoaded"
        Unloaded="SymbolSelectorUnloadedHandler">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="selector_header"
                   Style="{StaticResource base_textblock_style}"
                   VerticalAlignment="Center">
            <ContentPresenter Content="{Binding Path=SelectedValue, ElementName=options_listview}"
                              ContentTemplate="{StaticResource selected_symbol_pair_template}" />
        </TextBlock>

        <Polygon x:Name="toggle_icon"
                 Grid.Column="1"
                 Style="{StaticResource vector_down_icon_style}" 
                 Margin="0,9,0,0"/>

        <ListView x:Name="options_listview"
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  IsSynchronizedWithCurrentItem="True"
                  SelectedValue="{Binding Path=SymbolViewModel.SelectedSymbolVM}"
                  ItemsSource="{Binding Path=SymbolViewModel.Symbols}"
                  Style="{StaticResource symbol_pair_listview_style}" 
                  Loaded="OnOptionsListViewLoaded">
        </ListView>
    </Grid>
</Border>
