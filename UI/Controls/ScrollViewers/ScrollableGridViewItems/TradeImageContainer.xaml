<Border x:Class="UI.Controls.ScrollViewers.ScrollableGridViewItems.TradeImageContainer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.ScrollViewers.ScrollableGridViewItems"
        BorderBrush="{DynamicResource theme_background_inverse_brush}"
        Style="{StaticResource highlightable_border_style}"
        Height="Auto"
        BorderThickness="3,3,1,1"
        CornerRadius="3"
        mc:Ignorable="d" 
        d:DesignHeight="128" 
        d:DesignWidth="128"
        Margin="5">

    <Image x:Name="image_control"
           Margin="5"/>
</Border>
