<Border x:Class="UI.Controls.ScrollViewers.ListViewItems.TradesListViewItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.ScrollViewers.ListViewItems"
        mc:Ignorable="d" 
        BorderBrush="{StaticResource green_brush}"
        BorderThickness="1"
        CornerRadius="3"
        Height="160" 
        d:DesignWidth="1000" 
        Margin="0,0,0,10">
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="96"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CheckBox VerticalAlignment="Center"
              HorizontalAlignment="Center"/>

        <TextBlock Grid.Column="1"
                   Text="Status"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="2"
                   Text="Open date"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="3"
                   Text="Open Price"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="4"
                   Text="TP"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="5"
                   Text="Symbol"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="6"
                   Text="Costs"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="7"
                   Text="Images"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="9"
                   Text="Edit"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>
    </Grid>
</Border>
