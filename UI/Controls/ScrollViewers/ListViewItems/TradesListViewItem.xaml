<Border x:Class="UI.Controls.ScrollViewers.ListViewItems.TradesListViewItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.ScrollViewers.ListViewItems"
        xmlns:homeViewButton="clr-namespace:UI.Controls.Buttons.HomeView"
        mc:Ignorable="d" 
        Style="{StaticResource listview_item_container_style}"
        Height="160" 
        d:DesignWidth="1000" 
        MouseEnter="UpdateContextTradeHandler" 
        Margin="0,0,10,10">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="10"
                Background="{DynamicResource green_brush}"/>

        <CheckBox Style="{StaticResource base_check_box_style}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"/>

        <TextBlock Grid.Column="1"
                   Text="Status"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <Border Grid.Column="1"
                Grid.Row="1"
                BorderThickness="2"
                CornerRadius="3" 
                Margin="15,10,15,10">

            <Border.BorderBrush>
                <MultiBinding Converter="{StaticResource binary_to_status_brush_converter}">
                    <Binding Path="IsOpen"/>
                    <Binding Path="OpenPrice"/>
                    <Binding Path="ClosePrice"/>
                    <Binding Path="IsLong"/>
                    <Binding Path="Volume"/>
                    <Binding Path="Swap"/>
                    <Binding Path="Spread"/>
                    <Binding Path="Commission"/>
                    <Binding Path="OtherCosts"/>
                </MultiBinding>
            </Border.BorderBrush>
            
            <TextBlock x:Name="trade_status_textblock"
                       VerticalAlignment="Center"
                       Style="{StaticResource base_textblock_style}" 
                       Loaded="OnTradeStatusTextBlockLoaded"/>
        </Border>
        
        <Border Grid.Row="2"
                Grid.ColumnSpan="10"
                Background="{DynamicResource green_brush}"/>
        
        <TextBlock Grid.Column="1"
                   Grid.Row="2"
                   Text="Side"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <Border Grid.Column="1"
                Grid.Row="4"
                BorderBrush="{Binding Path=IsLong, Converter={StaticResource binary_to_side_brush_converter}}"
                BorderThickness="2"
                CornerRadius="3"
                Margin="15,10,15,10">

            <TextBlock x:Name="trade_side_textblock"
                       VerticalAlignment="Center"
                       Style="{StaticResource base_textblock_style}" 
                       Loaded="OnTradeSideTextBlockLoaded"/>
        </Border>
        
        <TextBlock Grid.Column="2"
                   Text="Open date"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="2"
                   Grid.Row="4"
                   Text="{Binding Path=CloseDate, Converter={StaticResource date_to_ticks_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="2"
                   Grid.Row="1"
                   Text="{Binding Path=OpenDate, Converter={StaticResource date_to_ticks_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="2"
                   Grid.Row="2"
                   Text="Close date"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="3"
                   Text="Open price"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="3"
                   Grid.Row="1"
                   Text="{Binding Path=OpenPrice}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="3"
                   Grid.Row="2"
                   Text="Close price"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="3"
                   Grid.Row="4"
                   Text="{Binding Path=ClosePrice, Converter={StaticResource zero_to_no_value_representation_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="4"
                   Text="TP"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="4"
                   Grid.Row="1"
                   Text="{Binding Path=TakeProfit}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="4"
                   Grid.Row="2"
                   Text="SL"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="4"
                   Grid.Row="4"
                   Text="{Binding Path=StopLoss}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="5"
                   Text="Asset"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="5"
                   Grid.Row="1"
                   Text="{Binding Path=PairTraded}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="5"
                   Grid.Row="2"
                   Text="Volume"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="5"
                   Grid.Row="4"
                   Text="{Binding Path=Volume}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="6"
                   Text="Costs"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <Button Grid.Column="6"
                Grid.Row="1"
                Content="See Costs"
                Style="{StaticResource text_buttons_style}" 
                Margin="20,0,20,0" Click="OpenTradeCostsWindowHandler"/>

        <TextBlock Grid.Column="6"
                   Grid.Row="2"
                   Text="ROI"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="6"
                   Grid.Row="4"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}">
            
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} $ /{1}%">
                    <Binding Path="Roi"/>
                    <Binding Path="RoiPercentage"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <TextBlock Grid.Column="7"
                   Text="Images"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <homeViewButton:OpenImagesFolderButton Grid.Column="7"
                                               Grid.Row="1" 
                                               Margin="24,0,24,0" 
                                               Click="OpenTradeImagesWindowHandler"
                                               Command="{Binding Path=MainNavigationHelper.NavigateToTradeImagesCommand}"/>

        <TextBlock Grid.Column="7"
                   Grid.Row="2"
                   Text="Notes"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <homeViewButton:OpenTradeNotesButton Grid.Column="7"
                                             Grid.Row="4" 
                                             Margin="32,0,32,0" 
                                             Click="OpenTradeNotesWindowHandler"/>

        <TextBlock Grid.Column="8"
                   Text="Edit"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <homeViewButton:EditTradeButton Grid.Column="8"
                                        Grid.Row="1" 
                                        Margin="32,0,32,0"/>

        <TextBlock Grid.Column="8"
                   Grid.Row="2"
                   Text="Mistakes"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <homeViewButton:OpenTradeMistakesButton Grid.Column="8"
                                                Grid.Row="4" 
                                                Margin="32,0,32,0" 
                                                Click="OpenTradeMistakesWindowHandler"/>

        <TextBlock Grid.Column="9"
                   Text="Risk management"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="9"
                   Grid.Row="1"
                   Text="{Binding Path=StrategyName}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="9"
                   Text="Leverage"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Row="3"
                   Grid.Column="9"
                   Text="{Binding Path=Leverage, StringFormat=x{0}, 
                   Converter={StaticResource zero_to_one_value_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>
    </Grid>
</Border>
