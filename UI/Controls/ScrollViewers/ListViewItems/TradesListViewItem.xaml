<Border x:Class="UI.Controls.ScrollViewers.ListViewItems.TradesListViewItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.ScrollViewers.ListViewItems"
        xmlns:homeViewButton="clr-namespace:UI.Controls.Buttons.HomeView"
        xmlns:warningMessages="clr-namespace:UI.Controls.WarningMessages"
        mc:Ignorable="d" 
        Style="{StaticResource listview_item_container_style}"
        Height="160" 
        d:DesignWidth="1000" 
        MouseEnter="UpdateContextTradeHandler" 
        Margin="0,0,10,10" 
        Loaded="OnTradeListViewItemLoadedHandler" 
        Unloaded="TradesListViewItemUnloadedHandler">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="10"
                Background="{DynamicResource green_brush}"/>

        <CheckBox x:Name="trade_checkbox"
                  Style="{StaticResource base_checkbox_style}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center" 
                  Checked="OnTradeCheckBoxCheckedHandler" Unchecked="OnTradeCheckBoxUncheckedHandler"/>

        <TextBlock Grid.Column="1"
                   Text="Status"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <Border Grid.Column="1"
                Grid.Row="1"
                BorderThickness="2"
                CornerRadius="3" 
                Margin="15,10,15,10">

            <Border.BorderBrush>
                <MultiBinding Converter="{StaticResource binary_to_status_brush_converter}">
                    <Binding Path="IsOpen"/>
                    <Binding Path="OpenPrice"/>
                    <Binding Path="ClosePrice"/>
                    <Binding Path="IsLong"/>
                    <Binding Path="Volume"/>
                    <Binding Path="Swap"/>
                    <Binding Path="Spread"/>
                    <Binding Path="Commission"/>
                    <Binding Path="OtherCosts"/>
                </MultiBinding>
            </Border.BorderBrush>

            <TextBlock x:Name="trade_status_textblock"
                       VerticalAlignment="Center"
                       Style="{StaticResource base_textblock_style}" 
                       Loaded="OnTradeStatusTextBlockLoaded"/>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="10"
                Background="{DynamicResource green_brush}"/>

        <TextBlock Grid.Column="1"
                   Grid.Row="2"
                   Text="Side"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <Border Grid.Column="1"
                Grid.Row="4"
                BorderBrush="{Binding Path=IsLong, Converter={StaticResource binary_to_side_brush_converter}}"
                BorderThickness="2"
                CornerRadius="3"
                Margin="15,10,15,10">

            <TextBlock x:Name="trade_side_textblock"
                       VerticalAlignment="Center"
                       Style="{StaticResource base_textblock_style}" 
                       Loaded="OnTradeSideTextBlockLoaded"/>
        </Border>

        <TextBlock Grid.Column="2"
                   Text="Open date"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="2"
                   Grid.Row="4"
                   Text="{Binding Path=CloseDate, Converter={StaticResource date_to_ticks_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="2"
                   Grid.Row="1"
                   Text="{Binding Path=OpenDate, Converter={StaticResource date_to_ticks_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="2"
                   Grid.Row="2"
                   Text="Close date"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="3"
                   Text="Open price"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="3"
                   Grid.Row="1"
                   Text="{Binding Path=OpenPrice, Converter={StaticResource double_to_truncated_double_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="3"
                   Grid.Row="2"
                   Text="Close price"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="3"
                   Grid.Row="4"
                   Text="{Binding Path=ClosePrice, Converter={StaticResource zero_to_no_value_representation_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="4"
                   Text="TP"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="4"
                   Grid.Row="1"
                   Text="{Binding Path=TakeProfit, Converter={StaticResource double_to_truncated_double_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="4"
                   Grid.Row="2"
                   Text="SL"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="4"
                   Grid.Row="4"
                   Text="{Binding Path=StopLoss, Converter={StaticResource double_to_truncated_double_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="5"
                   Text="Asset"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="5"
                   Grid.Row="1"
                   Text="{Binding Path=PairTraded}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="5"
                   Grid.Row="2"
                   Text="Volume"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="5"
                   Grid.Row="4"
                   Text="{Binding Path=Volume, Converter={StaticResource double_to_truncated_double_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="6"
                   Text="Costs"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <Button Grid.Column="6"
                Grid.Row="1"
                Content="See Costs"
                Style="{StaticResource text_buttons_style}" 
                Margin="20,0,20,0" Click="OpenTradeCostsWindowHandler"/>

        <TextBlock Grid.Column="9"
                   Grid.Row="2"
                   Text="ROI"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <Image Grid.Column="9"
               Grid.Row="2"
               Source="{StaticResource warning_icon}"
               Margin="71,11,14,9" 
               Width="12" 
               Height="12" 
               MouseEnter="OnTradeRiskWarningMouseEnterHandler" 
               MouseLeave="OnTradeRiskWarningMouseLeaveHandler"/>

        <warningMessages:TradeRiskConstraintViolated x:Name="trade_risk_constraint_warning"
                                                     Grid.Column="7"
                                                     Grid.ColumnSpan="3"
                                                     Grid.Row="2"
                                                     Grid.RowSpan="2"
                                                     Visibility="Hidden"
                                                     Panel.ZIndex="1"
                                                     Margin="60,8,49,15"
                                                     MouseLeave="OnTradeRiskWarningMouseLeaveHandler"/>

        <TextBlock Grid.Column="9"
                   Grid.Row="4"
                   VerticalAlignment="Center"
                   Visibility="{Binding Path=Text, RelativeSource={RelativeSource Mode=Self},
                                Converter={StaticResource roi_text_block_visibility_converter}}"
                   Style="{StaticResource base_textblock_style}">

            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} $ /{1}%">
                    <Binding Path="Roi" Converter="{StaticResource double_to_truncated_double_converter}"/>
                    <Binding Path="RoiPercentage" Converter="{StaticResource double_to_truncated_double_converter}"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <TextBlock Grid.Column="7"
                   Text="Images"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <homeViewButton:OpenImagesFolderButton Grid.Column="7"
                                               Grid.Row="1" 
                                               Margin="24,0,24,0" 
                                               Click="OpenTradeImagesWindowHandler"
                                               Command="{Binding Path=MainNavigationHelper.NavigateToTradeImagesCommand}"/>

        <TextBlock Grid.Column="7"
                   Grid.Row="2"
                   Text="Notes"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <homeViewButton:OpenTradeNotesButton Grid.Column="7"
                                             Grid.Row="4" 
                                             Margin="32,0,32,0" 
                                             Click="OpenTradeNotesWindowHandler"/>

        <TextBlock Grid.Column="8"
                   Text="Edit"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <homeViewButton:EditTradeButton Grid.Column="8"
                                        Grid.Row="1" 
                                        Margin="32,0,32,0" 
                                        Click="OpenEditTradeWindowHandler"/>

        <TextBlock Grid.Column="8"
                   Grid.Row="2"
                   Text="Mistakes"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <homeViewButton:OpenTradeMistakesButton Grid.Column="8"
                                                Grid.Row="4" 
                                                Margin="32,0,32,0" 
                                                Click="OpenTradeMistakesWindowHandler"/>

        <TextBlock Grid.Column="9"
                   Text="Risk management"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <Border Grid.Column="9"
                Background="white"
                Visibility="{Binding Path=Visibility, ElementName=daily_goal_warning_icon}"
                Margin="80,11,-63,9" 
                Width="8" 
                Height="8"
                CornerRadius="10"/>

        <Image x:Name="daily_goal_warning_icon"
               Grid.Column="9"
               Source="{StaticResource yellow_warning_icon}"
               Visibility="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=Self},
                            Converter={StaticResource dail_goal_constraint_visibility_converter}}"
               Margin="80,11,-63,9"
               Panel.ZIndex="1"
               Width="14"
               Height="14" 
               MouseEnter="OnDailyGoalWarningMouseEnterHandler" 
               MouseLeave="OnDailyGoalWarningMouseLeaveHandler" Loaded="DailyGoalWarningIconLoadedHandler"/>

        <warningMessages:DailyGoalConstraintAchieved x:Name="daily_goal_constraint_warning"
                                                     Grid.Column="8"
                                                     Grid.ColumnSpan="2"
                                                     Grid.RowSpan="4"
                                                     Visibility="Hidden"
                                                     Panel.ZIndex="1"
                                                     Margin="16,5,10,71"
                                                     MouseLeave="OnDailyGoalWarningMouseLeaveHandler"/>

        <TextBlock Grid.Column="9"
                   Grid.Row="1"
                   Text="{Binding Path=StrategyName}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="6"
                   Text="Leverage"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Row="3"
                   Grid.Column="6"
                   Text="{Binding Path=Leverage, StringFormat=x{0}, 
                   Converter={StaticResource zero_to_one_value_converter}}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>
    </Grid>
</Border>
