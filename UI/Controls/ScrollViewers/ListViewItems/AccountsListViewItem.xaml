<Border x:Class="UI.Controls.ScrollViewers.ListViewItems.AccountsListViewItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        BorderBrush="{StaticResource green_brush}"
        BorderThickness="1"
        CornerRadius="3"
        Height="80" 
        d:DesignWidth="800"
        Margin="0,0,10,10">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3"
                Background="{StaticResource green_brush}"/>

        <TextBlock Text="Name"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="1"
                   Text="Initial Balance"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="2"
                   Text="Balance"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding Path=Name}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="1"
                   Grid.Row="1"
                   Text="{Binding Path=InitialBalance}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="2"
                   Grid.Row="1"
                   Text="{Binding Path=CurrentBalance}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>
    </Grid>
</Border>
