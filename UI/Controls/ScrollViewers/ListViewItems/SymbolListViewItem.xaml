<Border x:Class="UI.Controls.ScrollViewers.ListViewItems.SymbolListViewItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.ScrollViewers.ListViewItems"
        xmlns:commonButtons="clr-namespace:UI.Controls.Buttons.Common"
        Style="{StaticResource listview_item_container_style}"
        mc:Ignorable="d"
        Margin="0,0,10,10"
        Height="80" 
        d:DesignWidth="800">
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="64"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3"
                Background="{StaticResource green_brush}"/>

        <TextBlock Text="Pair"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="1"
                   Text="Asset type"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding Path=Pair}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <TextBlock Grid.Column="1"
                   Grid.Row="1"
                   Text="{Binding Path=AssetType}"
                   VerticalAlignment="Center"
                   Style="{StaticResource base_textblock_style}"/>

        <commonButtons:DeleteItemButton Grid.Column="2"
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Click="OnDeleteSymbolButtonClickHandler"/>
    </Grid>
</Border>
