<Button x:Class="UI.Controls.Buttons.MainWindow.QuitButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="32" 
             d:DesignWidth="32">
    
    <Button.Template>
        <ControlTemplate>
            <Border x:Name="button_template"
                Background="{DynamicResource theme_background_brush}">

                <Image Source="{DynamicResource quit_button_icon}" 
                       Margin="10,10,10,10"/>
            </Border>

            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="button_template"
                            Property="Background"
                            Value="{StaticResource error_red_brush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Button.Template>
</Button>
