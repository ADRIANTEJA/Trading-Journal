<Grid x:Class="UI.Controls.Buttons.MainWindow.ThemeOptions"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="32" 
      d:DesignWidth="150">
    
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="2*"/>
    </Grid.ColumnDefinitions>

    <Border x:Name="light_theme_button"
            BorderThickness="1"
            CornerRadius="3" 
            Margin="1">

        <Button Style="{StaticResource light_theme_button_style}" 
                Click="SwitchToLightThemeHandler"/>
    </Border>

    <Border x:Name="dark_theme_button"
            Grid.Column="1"
            BorderThickness="1"
            CornerRadius="3"
            Margin="1">

        <Button Style="{StaticResource dark_theme_button_style}" 
                Click="SwitchToDarkThemeHandler"/>
    </Border>
</Grid>
