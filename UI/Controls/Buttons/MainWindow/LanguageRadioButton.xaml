<Grid x:Class="UI.Controls.Buttons.MainWindow.LanguageRadioButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="32" 
             d:DesignWidth="130"
             x:Name="template">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <RadioButton x:Name="radio_button"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 GroupName="languages" 
                 Checked="SwitchLanguageHandler"/>

    <TextBlock x:Name="language_option"
               Grid.Column="1"
               Style="{StaticResource base_textblock_style}"
               Text="{Binding Path=Tag, ElementName=template}"/>
</Grid>
