<liveCharts:PieChart x:Class="UI.Controls.Charts.StrategyView.StrategyPerformancePieChart"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                     xmlns:local="clr-namespace:UI.Controls.Charts.StrategyView"
                     xmlns:liveCharts="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
                     Name="strategy_performance_pie_chart"
                     Background="{DynamicResource theme_control_wrapper_background_brush}"
                     Foreground="{DynamicResource theme_font_brush}"
                     FontSize="{DynamicResource font_size}"
                     FontFamily="Calibri"
                     LegendLocation="Left"
                     mc:Ignorable="d" 
                     d:DesignHeight="400" 
                     d:DesignWidth="800">
    
    <liveCharts:PieChart.DataTooltip>
        <liveCharts:DefaultTooltip Background="{StaticResource theme_background_brush}"
                                   BorderBrush="{StaticResource green_brush}"
                                   BorderThickness="2"
                                   Visibility="Hidden"
                                   Foreground="{StaticResource theme_font_brush}"
                                   FontSize="{StaticResource font_size}"
                                   CornerRadius="3"
                                   SelectionMode="OnlySender"
                                   FontFamily="Calibri"/>
    </liveCharts:PieChart.DataTooltip>

</liveCharts:PieChart>
