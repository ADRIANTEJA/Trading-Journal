<liveCharts:CartesianChart x:Class="UI.Controls.Charts.AccountView.AccountPerformanceLineChart"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                           xmlns:liveCharts="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
                           xmlns:local="clr-namespace:UI.Controls.Charts.AccountView"
                           mc:Ignorable="d"
                           Zoom="X"
                           Pan="X"
                           Cursor="ScrollWE"
                           ZoomingSpeed="0.5"
                           DisableAnimations="False"
                           d:DesignHeight="450"
                           d:DesignWidth="800">

    <liveCharts:CartesianChart.AxisX>

        <liveCharts:Axis x:Name="x_axis"
                         Title="Date"
                         Foreground="{DynamicResource theme_font_brush}"
                         MaxValue="{Binding Path=PerformanceViewModel.AccountPerformance,
                                    Converter={StaticResource collection_to_last_value_converter}}"
                         ShowLabels="False"
                         FontSize="{DynamicResource font_size}"
                         FontFamily="Calibri">

            <liveCharts:Axis.Separator>
                <liveCharts:Separator Stroke="Transparent"/>
            </liveCharts:Axis.Separator>
        </liveCharts:Axis>
    </liveCharts:CartesianChart.AxisX>

    <liveCharts:CartesianChart.AxisY>

        <liveCharts:Axis x:Name="y_axis"
                         Title="ROI"
                         Foreground="{DynamicResource theme_font_brush}"
                         FontFamily="Calibri"
                         FontSize="{DynamicResource font_size}"
                         LabelFormatter="{StaticResource roi_value_label_formatter}">

            <liveCharts:Axis.Separator>
                <liveCharts:Separator Stroke="{DynamicResource theme_button_highlight_brush}"
                                      StrokeThickness="0.5"
                                      Step="1000"/>
            </liveCharts:Axis.Separator>
            
        </liveCharts:Axis>
    </liveCharts:CartesianChart.AxisY>

    <liveCharts:CartesianChart.DataTooltip>
        <liveCharts:DefaultTooltip Background="{StaticResource theme_background_brush}"
                                   BorderBrush="{StaticResource green_brush}"
                                   BorderThickness="2"
                                   Visibility="Visible"
                                   Foreground="{StaticResource theme_font_brush}"
                                   FontSize="{StaticResource font_size}"
                                   CornerRadius="3"
                                   SelectionMode="OnlySender"
                                   FontFamily="Calibri"/>
    </liveCharts:CartesianChart.DataTooltip>
</liveCharts:CartesianChart>
