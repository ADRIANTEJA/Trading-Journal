<liveCharts:PieChart x:Class="UI.Controls.Charts.AccountView.StrategyUsePieChart"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                     xmlns:local="clr-namespace:UI.Controls.Charts.AccountView"
                     xmlns:liveCharts="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
                     Background="{DynamicResource theme_control_wrapper_background_brush}"
                     Foreground="{DynamicResource theme_font_brush}"
                     InnerRadius="100"
                     LegendLocation="Right"
                     mc:Ignorable="d"
                     d:DesignHeight="450" 
                     d:DesignWidth="800">

    <liveCharts:PieChart.Series>
        <liveCharts:PieSeries Values="2"
                              Stroke="Transparent"/>
        <liveCharts:PieSeries Values="5"
                              Stroke="Transparent"/>
        <liveCharts:PieSeries Values="1"
                              Stroke="Transparent"/>
    </liveCharts:PieChart.Series>
</liveCharts:PieChart>
