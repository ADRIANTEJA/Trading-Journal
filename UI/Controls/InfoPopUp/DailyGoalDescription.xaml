<Border x:Class="UI.Controls.InfoPopUp.DailyGoalDescription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.InfoPopUp"
        mc:Ignorable="d" 
        Background="{DynamicResource theme_background_brush}"
        BorderBrush="{StaticResource theme_font_brush}"
        BorderThickness="1"
        Height="120" 
        Width="250">

    <TextBlock Text="The amount you expect to win each day of trading. Represents a percentage of the balance the account had when trading started that day"
               TextWrapping="Wrap"
               Style="{StaticResource base_textblock_style}"
               Foreground="{DynamicResource theme_font_brush}"
               VerticalAlignment="Center"
               Margin="5"/>
</Border>
