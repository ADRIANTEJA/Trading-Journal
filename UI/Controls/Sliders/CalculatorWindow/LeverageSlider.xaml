<Grid x:Class="UI.Controls.Sliders.CalculatorWindow.LeverageSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:UI.Common.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="64" 
             d:DesignWidth="290">

    <Grid.Resources>
        <Style x:Key="leverage_slider_style" TargetType="{x:Type Slider}">
            <Setter Property="Minimum" Value="1"/>
            <Setter Property="Maximum" Value="150"/>
            <Setter Property="SelectionStart" Value="1"/>
            <Setter Property="SelectionEnd" Value="{Binding 
                                                    RelativeSource={RelativeSource Self},
                                                    Path=Value}"/>
            <Setter Property="IsSelectionRangeEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        
                        <ControlTemplate.Resources>
                            <converters:SliderValueToBooleanConverter x:Key="slider_value_to_boolean_converter"/>
                        </ControlTemplate.Resources>
                        
                        <Grid Background="{TemplateBinding Background}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <Border Height="2.0"
                                    Grid.ColumnSpan="6"
                                    Background="{DynamicResource theme_background_inverse_brush}"
                                    Margin="8,0,8,0"/>

                            <Border x:Name="PART_SelectionRange"
                                    Grid.ColumnSpan="6"
                                    Height="2.0"
                                    Background="{StaticResource green_brush}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Margin="8,0,8,0"/>

                            <Border x:Name="slider_first_level"
                                    Background="{StaticResource green_brush}"
                                    CornerRadius="2" 
                                    Margin="6,1,36,1"/>
                            <Border x:Name="slider_second_level"
                                    Grid.Column="1"
                                    Background="{DynamicResource theme_background_inverse_brush}"
                                    CornerRadius="2"
                                    Margin="10,1,32,1"/>
                            <Border x:Name="slider_third_level"
                                    Grid.Column="2"
                                    Background="{DynamicResource theme_background_inverse_brush}"
                                    CornerRadius="2"
                                    Margin="16,1,26,1"/>
                            <Border x:Name="slider_fourth_level"
                                    Grid.Column="3"
                                    Background="{StaticResource theme_background_inverse_brush}"
                                    CornerRadius="2"
                                    Margin="22,1,20,1"/>
                            <Border x:Name="slider_fifth_level"
                                    Grid.Column="4"
                                    Background="{DynamicResource theme_background_inverse_brush}"
                                    CornerRadius="2"
                                    Margin="28,1,14,1"/>
                            <Border x:Name="slider_sixth_level"
                                    Grid.Column="5"
                                    Background="{DynamicResource theme_background_inverse_brush}"
                                    CornerRadius="2"
                                    Margin="36,1,6,1"/>

                            <Track x:Name="PART_Track"
                                   Grid.ColumnSpan="6">
                                <Track.Thumb>
                                    <Thumb MouseEnter="ShowGrabCursorHandler"
                                           DragStarted="ShowGrabbingCursorHandler">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse x:Name="track_ellipse"
                                                         Width="16" 
                                                         Height="16"
                                                         Fill="{StaticResource green_brush}"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelectionRangeEnabled" Value="True">
                                <Setter TargetName="PART_SelectionRange"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Path=Value, RelativeSource={RelativeSource Mode=Self},
                                                   Converter={StaticResource slider_value_to_boolean_converter},
                                                   ConverterParameter=30}" 
                                         Value="True">
                                <Setter TargetName="slider_second_level"
                                        Property="Background"
                                        Value="{StaticResource green_brush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Value, RelativeSource={RelativeSource Mode=Self},
                                                   Converter={StaticResource slider_value_to_boolean_converter},
                                                   ConverterParameter=60}" 
                                         Value="True">
                                <Setter TargetName="slider_third_level"
                                        Property="Background"
                                        Value="{StaticResource green_brush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Value, RelativeSource={RelativeSource Mode=Self}, 
                                                   Converter={StaticResource slider_value_to_boolean_converter},
                                                   ConverterParameter=90}" 
                                         Value="True">
                                <Setter TargetName="slider_fourth_level"
                                        Property="Background"
                                        Value="{StaticResource green_brush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Value, RelativeSource={RelativeSource Mode=Self}, 
                                                   Converter={StaticResource slider_value_to_boolean_converter},
                                                   ConverterParameter=120}" 
                                         Value="True">
                                <Setter TargetName="slider_fifth_level"
                                        Property="Background"
                                        Value="{StaticResource green_brush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Value, RelativeSource={RelativeSource Mode=Self}, 
                                                   Converter={StaticResource slider_value_to_boolean_converter},
                                                   ConverterParameter=150}" 
                                         Value="True">
                                <Setter TargetName="slider_sixth_level"
                                        Property="Background"
                                        Value="{StaticResource green_brush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="6*"/>
        <ColumnDefinition Width="6*"/>
        <ColumnDefinition Width="6*"/>
        <ColumnDefinition Width="6*"/>
        <ColumnDefinition Width="6*"/>
        <ColumnDefinition Width="6*"/>
    </Grid.ColumnDefinitions>
    
    <Grid.RowDefinitions>
        <RowDefinition Height="3*"/>
        <RowDefinition Height="3*"/>
        <RowDefinition Height="3*"/>
    </Grid.RowDefinitions>
    

    <TextBlock x:Name="leverage_label"
               Text="{DynamicResource leverage_slider_leverage_label}"
               Grid.ColumnSpan="6"
               Style="{StaticResource base_textblock_style}"/>

    <TextBlock Text="{Binding ElementName=leverage_slider, Path=Value}"
               Grid.Column="4"
               Style="{StaticResource base_textblock_style}" 
               Margin="0,0,20,0"
               TextAlignment="Left"/>

    <Slider x:Name="leverage_slider"
            Grid.ColumnSpan="6"
            Grid.Row="1"
            Style="{StaticResource leverage_slider_style}" 
            Margin="10,5,10,0"/>

    <TextBlock Text="1x"
               Grid.Row="2"
               Style="{StaticResource base_textblock_style}" 
               Margin="0,0,10,0"/>
    <TextBlock Text="30x"
               Grid.Column="1"
               Grid.Row="2"
               Style="{StaticResource base_textblock_style}" 
               Margin="0,0,10,0"/>
    <TextBlock Text="60x"
               Grid.Column="2"
               Grid.Row="2"
               Style="{StaticResource base_textblock_style}" 
               Margin="0,0,2,0"/>
    <TextBlock Text="90x"
               Grid.Column="3"
               Grid.Row="2"
               Style="{StaticResource base_textblock_style}" 
               Margin="3,0,0,0"/>
    <TextBlock Text="120x"
               Grid.Column="4"
               Grid.Row="2"
               Style="{StaticResource base_textblock_style}" 
               Margin="4,0,0,0"/>
    <TextBlock Text="150x"
               Grid.Column="5"
               Grid.Row="2"
               Style="{StaticResource base_textblock_style}" 
               Margin="17,0,0,0"/>
</Grid>
