<Grid x:Class="UI.Controls.Sliders.MainWindow.FontSizeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="32"
             d:DesignWidth="150">
    
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="50"/>
        <ColumnDefinition Width="50"/>
        <ColumnDefinition Width="50"/>
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
        <RowDefinition Height="2*"/>
        <RowDefinition Height="2*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.ColumnSpan="3"
               Text="{DynamicResource main_window_font_size_slider}"
               Style="{StaticResource base_textblock_style}"/>
    
    <Slider x:Name="font_size_slider"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Style="{StaticResource font_size_slider_style}" 
            Margin="10,0,10,0" 
            ValueChanged="FontSizeChangeHandler"/>
</Grid>
