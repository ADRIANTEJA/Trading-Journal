<Grid x:Class="UI.Controls.Sliders.MainWindow.FontSizeSlider"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="32"
      d:DesignWidth="150">

    <Grid.Resources>
        <Style x:Key="font_size_slider_style" TargetType="{x:Type Slider}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="2"/>
            <Setter Property="SelectionStart" Value="0"/>
            <Setter Property="SelectionEnd" Value="{Binding 
                                                    RelativeSource={RelativeSource Self},
                                                    Path=Value}"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="IsSelectionRangeEnabled" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Height="2.0" 
                                    Background="{DynamicResource theme_background_inverse_brush}"
                                    Margin="8,0,8,0"/>

                            <Border x:Name="PART_SelectionRange"
                                    Height="2.0"
                                    Background="{StaticResource green_brush}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Margin="8,0,8,0"/>

                            <Border x:Name="slider_first_level"
                                    Background="{StaticResource green_brush}"
                                    Margin="6,1,121,1"
                                    CornerRadius="1"/>
                            <Border x:Name="slider_second_level"
                                    Background="{DynamicResource theme_background_inverse_brush}"
                                    Margin="64,1,63,1"
                                    CornerRadius="1"/>
                            <Border x:Name="slider_third_level"
                                    Background="{DynamicResource theme_background_inverse_brush}"
                                    Margin="121,1,6,1"
                                    CornerRadius="1"/>

                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb MouseEnter="ShowGrabCursorHandler"
                                           DragStarted="ShowGrabbingCursorHandler">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse x:Name="track_ellipse"
                                                         Width="16" 
                                                         Height="16"
                                                         Fill="{StaticResource green_brush}"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"/>

                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelectionRangeEnabled" Value="True">
                                <Setter TargetName="PART_SelectionRange"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Value" Value="2">
                                <Setter TargetName="slider_second_level"
                                        Property="Background"
                                        Value="{StaticResource green_brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>
    
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="50"/>
        <ColumnDefinition Width="50"/>
        <ColumnDefinition Width="50"/>
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
        <RowDefinition Height="2*"/>
        <RowDefinition Height="2*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.ColumnSpan="3"
               Text="{DynamicResource main_window_font_size_slider}"
               Style="{StaticResource base_textblock_style}"
               VerticalAlignment="Center" 
               Margin="0,0,0,6"/>
    
    <Slider x:Name="font_size_slider"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Style="{StaticResource font_size_slider_style}" 
            Margin="10,0,10,0" 
            ValueChanged="FontSizeChangeHandler"/>
</Grid>
