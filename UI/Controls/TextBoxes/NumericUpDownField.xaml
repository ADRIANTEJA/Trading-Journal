<Border x:Class="UI.Controls.TextBoxes.NumericUpDownField"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.TextBoxes"
        mc:Ignorable="d"
        d:DesignHeight="32" 
        d:DesignWidth="100" 
        Loaded="NumericUpDownFieldLoadedHandler">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.RowSpan="2"
                   Text="1"
                   Style="{StaticResource base_textblock_style}"
                   VerticalAlignment="Center"
                   Margin="1,0,2,0"/>

        <TextBlock Grid.Column="1"
                   Grid.RowSpan="2"
                   Text="-"
                   Style="{StaticResource base_textblock_style}"
                   VerticalAlignment="Center"/>

        <TextBox x:Name="divisor_field"
                 Grid.Column="2"
                 Grid.RowSpan="2"
                 MaxLength="2"
                 Style="{StaticResource base_text_box_style}" 
                 Margin="2,0,5,0"
                 TextChanged="ValidateNumericValueHandler"/>

        <Button x:Name="increase_divisor_button"
                Grid.Column="4"
                Style="{StaticResource point_up_button_style}" 
                Margin="0,0,0,-1"
                Click="DivisorUpClickHandler"/>

        <Button x:Name="decrease_divisor_button"
                Grid.Column="4"
                Grid.Row="1"
                Style="{StaticResource point_down_button_style}"
                Click="DivisorDownClickHandler"/>
    </Grid>
</Border>
