<ResourceDictionary x:Class="UI.Common.Resources.Dictionaries.SpecificStyleDictionary"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:listViewItems="clr-namespace:UI.Controls.ScrollViewers.ListViewItems"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:liveCharts="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">

    <Style x:Key="dark_theme_button_style" 
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{DynamicResource theme_dark_icon}"
                               Margin="5,5,5,7"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource specific_style_dictionary_dark_theme_button}"
                                   Style="{StaticResource base_textblock_style}"
                                   VerticalAlignment="Center"
                                   Margin="5,5,5,7"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="light_theme_button_style" 
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{DynamicResource theme_light_icon}"
                               Margin="5,5,5,7"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource specific_style_dictionary_light_theme_button}"
                                   Style="{StaticResource base_textblock_style}"
                                   VerticalAlignment="Center"
                                   Margin="5,5,5,7"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="navigation_button_style" 
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="highlight"
                            Opacity="{TemplateBinding Opacity}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource green_brush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Style="{StaticResource base_textblock_style}"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource TemplatedParent}}">
                        </TextBlock>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="highlight"
                                    Property="Background"
                                    Value="{StaticResource green_brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="highlight"
                                    Property="Background"
                                    Value="{DynamicResource green_highlight_brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="home_navigation_button_style" 
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="highlight"
                            Opacity="{TemplateBinding Opacity}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource green_brush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Image Source="{DynamicResource home_button_icon}"
                               HorizontalAlignment="Center" 
                               Margin="0,7,0,7"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="highlight"
                                    Property="Background"
                                    Value="{StaticResource green_brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="highlight"
                                    Property="Background"
                                    Value="{DynamicResource green_highlight_brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="long_button_style" 
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="highlight"
                            Opacity="{TemplateBinding Opacity}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource green_brush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{DynamicResource long_button_icon}"
                                   Margin="0,6,0,4"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                       Style="{StaticResource base_textblock_style}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource TemplatedParent}}">
                            </TextBlock>
                        </Grid>
                        
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="highlight"
                                    Property="Background"
                                    Value="{StaticResource green_brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="highlight"
                                    Property="Background"
                                    Value="{DynamicResource green_highlight_brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="short_button_style" 
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="highlight"
                            Opacity="{TemplateBinding Opacity}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource salmon_brush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        
                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{DynamicResource short_button_icon}"
                                   Margin="0,6,0,4"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                       Style="{StaticResource base_textblock_style}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource TemplatedParent}}">
                            </TextBlock>
                        </Grid>

                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="highlight"
                                    Property="Background"
                                    Value="{DynamicResource salmon_brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="highlight"
                                    Property="Background"
                                    Value="{DynamicResource salmon_highlight_brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="accounts_listview_item_style" TargetType="{x:Type ListViewItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <listViewItems:AccountsListViewItem/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="trades_listview_item_style" TargetType="{x:Type ListViewItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <listViewItems:TradesListViewItem DataContext="{Binding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="symbol_listview_item_style" TargetType="{x:Type ListViewItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <listViewItems:SymbolListViewItem DataContext="{Binding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="strategy_listview_item_style" TargetType="{x:Type ListViewItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <listViewItems:StrategyListViewItem DataContext="{Binding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="analysis_note_listview_item_style" TargetType="{x:Type ListViewItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <listViewItems:NotesListViewItem DataContext="{Binding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="selector_border_style" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="BorderBrush" Value="{StaticResource green_brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style x:Key="account_performance_line_series_style" TargetType="{x:Type liveCharts:LineSeries}">
        <Setter Property="Title" Value=""/>
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{StaticResource green_highlight_brush}"/>
        <Setter Property="Foreground" Value="{DynamicResource theme_font_brush}"/>
        <Setter Property="FontFamily" Value="Calibri"/>
        <Setter Property="FontSize" Value="{DynamicResource font_size}"/>
        <Setter Property="PointGeometrySize" Value="8"/>
        <Setter Property="LineSmoothness" Value="0"/>
        <Setter Property="DataLabels" Value="True"/>
        <Setter Property="Configuration" Value="{StaticResource performance_line_series_mapper}"/>
    </Style>

    <Style x:Key="symbol_category_button_expand_style"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Symbol"
                                   Style="{StaticResource base_textblock_style}"
                                   VerticalAlignment="Center"/>

                        <Polygon x:Name="toggle_icon_right"
                                 Grid.Column="1"
                                 Style="{StaticResource vector_right_icon_style}"
                                 Margin="0,12,0,0"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="toggle_icon_right"
                                    Property="Fill"
                                    Value="{StaticResource green_highlight_brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="symbol_category_button_collapse_style" 
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Symbol"
                                   Style="{StaticResource base_textblock_style}"
                                   VerticalAlignment="Center"/>

                        <Polygon x:Name="toggle_icon_left" 
                                 Grid.Column="1"
                                 Points="6,9,6,-1,0,4" 
                                 Fill="{StaticResource green_brush}" 
                                 Margin="0,12,0,0"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="toggle_icon_left"
                                    Property="Fill"
                                    Value="{StaticResource green_highlight_brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="mouse_over_highlighter" TargetType="{x:Type Border}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource theme_button_highlight_brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="delete_image_button_style" 
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="highlight"
                            Opacity="{TemplateBinding Opacity}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="selected_symbol_pair_template">
        <TextBlock Text="{Binding Path=Pair}"/>
    </DataTemplate>

    <DataTemplate x:Key="selected_strategy_name_template">
        <TextBlock Text="{Binding Path=Name}"/>
    </DataTemplate>

    <DataTemplate x:Key="selected_strategy_goal_textblock_template">
        <TextBlock Text="{Binding Path=Goal}"
                   TextWrapping="Wrap"/>
    </DataTemplate>

    <DataTemplate x:Key="selected_analysis_note_textblock_template">
        <TextBlock Text="{Binding Path=Text}"
                   TextWrapping="Wrap"/>
    </DataTemplate>

    <!--<Style x:Key="performance_date_textblock_style"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource base_textblock_style}">
        <Setter Property="Text" Value="{Binding Path=X}"/>
    </Style>-->

    <Style x:Key="symbol_pair_listview_style" 
           TargetType="{x:Type ListView}"
           BasedOn="{StaticResource base_listview_style}">
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border Height="32"
                                        Style="{StaticResource selectable_container_style}"
                                        Cursor="Hand"
                                        CornerRadius="3" 
                                        Margin="1,0,1,5">

                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource base_textblock_style}">
                                        <ContentPresenter Content="{Binding Path=Content, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                          ContentTemplate="{StaticResource selected_symbol_pair_template}"/>
                                    </TextBlock>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="strategy_name_listview_style" 
           TargetType="{x:Type ListView}"
           BasedOn="{StaticResource base_listview_style}">
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <Border Height="32"
                                        Style="{StaticResource selectable_container_style}"
                                        Cursor="Hand"
                                        CornerRadius="3" 
                                        Margin="1,0,1,5">

                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource base_textblock_style}">
                                    <ContentPresenter Content="{Binding Path=Content, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                      ContentTemplate="{StaticResource selected_strategy_name_template}"/>
                                    </TextBlock>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="hand_cursor_border_style"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource listview_item_container_style}">

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="Hand"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>