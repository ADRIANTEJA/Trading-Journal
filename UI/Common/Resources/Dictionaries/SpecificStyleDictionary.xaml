<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="dark_theme_button_style" 
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="{TemplateBinding Background}"
                          Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{DynamicResource theme_dark_icon}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource specific_style_dictionary_dark_theme_button}"
                                   Style="{StaticResource base_textblock_style}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="light_theme_button_style" 
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource base_buttons_style}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{DynamicResource theme_light_icon}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource specific_style_dictionary_light_theme_button}"
                                   Style="{StaticResource base_textblock_style}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="font_size_slider_style" TargetType="{x:Type Slider}">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="2"/>
        <Setter Property="SelectionStart" Value="0"/>
        <Setter Property="SelectionEnd" Value="{Binding 
                                                RelativeSource={RelativeSource Self},
                                                Path=Value}"/>
        <Setter Property="TickFrequency" Value="1"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="IsSelectionRangeEnabled" Value="True"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Height="2.0" 
                                Background="{DynamicResource theme_inverse_background_brush}"
                                Margin="8,0,8,0"/>
                        
                        <Border x:Name="PART_SelectionRange"
                                Height="2.0"
                                Background="{StaticResource green_controls_brush}"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Margin="8,0,8,0"/>
                        
                        <Border x:Name="slider_first_level"
                                Background="{StaticResource green_controls_brush}"
                                Margin="6,1,121,1"
                                CornerRadius="1"/>
                        <Border x:Name="slider_second_level"
                                Background="{DynamicResource theme_inverse_background_brush}"
                                Margin="64,1,63,1"
                                CornerRadius="1"/>
                        <Border x:Name="slider_third_level"
                                Background="{DynamicResource theme_inverse_background_brush}"
                                Margin="121,1,6,1"
                                CornerRadius="1"/>
                        
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Ellipse x:Name="track_ellipse"
                                                     Width="16" 
                                                     Height="16"
                                                     Fill="{StaticResource green_controls_brush}"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelectionRangeEnabled" Value="True">
                            <Setter TargetName="PART_SelectionRange"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Value" Value="2">
                            <Setter TargetName="slider_second_level"
                                    Property="Background"
                                    Value="{StaticResource green_controls_brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>