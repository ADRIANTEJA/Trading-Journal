<ResourceDictionary x:Class="UI.Common.Resources.Dictionaries.LightThemeDictionary"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="theme_background_brush" Color="#ffffff"/>
    <SolidColorBrush x:Key="theme_control_wrapper_background_brush" Color="#22D347"/>
    <!--for controls that require inverse color highlight-->
    <SolidColorBrush x:Key="theme_background_inverse_brush" Color="#151515"/>
    <SolidColorBrush x:Key="theme_button_highlight_brush" Color="#FFB4B4B4"/>
    <SolidColorBrush x:Key="theme_font_brush" Color="#141414"/>
    <SolidColorBrush x:Key="theme_place_holder_brush" Color="#E5505050"/>

    <BitmapImage x:Key="settings_theme_icon" 
                 UriSource="/Common/Resources/Assets/Icons/light_theme_settings_icon.png"/>
    <BitmapImage x:Key="theme_dark_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_theme_dark_icon.png"/>
    <BitmapImage x:Key="theme_light_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_theme_light_icon.png"/>
    <BitmapImage x:Key="quit_button_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_quit_button_icon.png"/>
    <BitmapImage x:Key="resize_button_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_rezize_button_icon.png"/>
    <BitmapImage x:Key="resize_fullscreen_button_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_rezize_fullscreen_button_icon.png"/>
    <BitmapImage x:Key="caculator_button_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_calculator_icon.png"/>
    <BitmapImage x:Key="home_button_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_home_button_icon.png"/>
    <BitmapImage x:Key="short_button_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_short_button_icon.png"/>
    <BitmapImage x:Key="long_button_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_long_button_icon.png"/>
    <BitmapImage x:Key="folder_icon"
                 UriSource="\Common\Resources\Assets\Icons\light_folder_icon.png"/>
    <BitmapImage x:Key="edit_icon"
                 UriSource="\Common\Resources\Assets\Icons\light_edit_icon.png"/>
    <BitmapImage x:Key="notes_icon"
                 UriSource="\Common\Resources\Assets\Icons\light_notes_icon.png"/>
    <BitmapImage x:Key="mistakes_icon"
                 UriSource="\Common\Resources\Assets\Icons\light_mistakes_icon.png"/>
    <BitmapImage x:Key="add_trade_image_icon"
                 UriSource="\Common\Resources\Assets\Icons\light_add_trade_image_icon.png"/>
</ResourceDictionary>