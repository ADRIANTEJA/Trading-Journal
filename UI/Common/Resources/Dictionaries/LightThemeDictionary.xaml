<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Name="dark_theme_dictionary">
    
    <SolidColorBrush x:Key="theme_background_brush" Color="#ffffff"/>
    <SolidColorBrush x:Key="theme_control_wrapper_background_brush" Color="#22D347"/>
    <!--for controls that require inverse color highlight-->
    <SolidColorBrush x:Key="theme_inverse_background_brush" Color="#151515"/>
    <SolidColorBrush x:Key="theme_button_highlight_brush" Color="#FFB4B4B4"/>
    <SolidColorBrush x:Key="theme_font_brush" Color="#141414"/>

    <BitmapImage x:Key="settings_theme_icon" 
                 UriSource="/Common/Resources/Assets/Icons/light_theme_settings_icon.png"/>
    <BitmapImage x:Key="theme_dark_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_theme_dark_icon.png"/>
    <BitmapImage x:Key="theme_light_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_theme_light_icon.png"/>
    <BitmapImage x:Key="quit_button_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_quit_button_icon.png"/>
    <BitmapImage x:Key="resize_button_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_rezize_button_icon.png"/>
    <BitmapImage x:Key="resize_fullscreen_button_icon"
                 UriSource="/Common/Resources/Assets/Icons/light_rezize_fullscreen_button_icon.png"/>
</ResourceDictionary>