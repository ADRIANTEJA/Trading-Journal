<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    
    <!--The key is composed by the name of the file where the control using it is located 
        and the name of the control, should the string be used in more than one control it will
        be specified in a comment above it, keys are also organized alphabetically-->

    <system:String x:Key="add_symbol_window_asset_type_error">Selecciona un tipo de activo</system:String>
    <system:String x:Key="add_symbol_window_duplicated_symbol_name_error">Ese par de activos ya esta registrado</system:String>
    <system:String x:Key="add_strategy_window_duplicated_strategy_name_error">Ya existe una estrategia con ese nombre</system:String>
    <!--also used in the add trade window for the asset type selector-->
    <system:String x:Key="add_trade_window_asset_type_selector_header">Tipo de activo</system:String>
    <system:String x:Key="add_account_window_duplicated_account_error_message">Ya existe una cuenta con este nombre</system:String>
    <!--also used for the window title-->
    <system:String x:Key="calculator_window_window_header">Calculadora</system:String>
    <system:String x:Key="calculator_window_target_price_button">Precio Objetivo</system:String>
    <system:String x:Key="calculator_window_calculate_button">Calcular</system:String>
    <!--This one is for the error message showed when convertion of a byte[] array to
        a BitMapSource fails due to some problem with jpg image format-->
    <system:String x:Key="image_convertion_error_message">Archive de imagen inválido</system:String>
    <system:String x:Key="leverage_slider_leverage_label">Apalancamiento</system:String>
    <system:String x:Key="main_window_settings_menu_header">Ajustes</system:String>
    <system:String x:Key="main_window_switch_theme_button">Tema</system:String>
    <system:String x:Key="main_window_font_size_slider">Tamaño de la fuente</system:String>
    <system:String x:Key="main_window_account_button">Cuenta</system:String>
    <system:String x:Key="main_window_strategy_button">Estrategia</system:String>
    <system:String x:Key="main_window_add_trade_button">Añadir Operación</system:String>
    <system:String x:Key="ROI_calculation_view_margin_field">Margen</system:String>
    <system:String x:Key="ROI_calculation_view_open_price_field">Precio de entrada</system:String>
    <system:String x:Key="ROI_calculation_view_close_price_field">Precio de salida</system:String>
    <!--also used for the same label in TargetPriceCalculationView-->
    <system:String x:Key="ROI_calculation_view_initial_margin_label">Margen inicial:</system:String>
    <system:String x:Key="specific_style_dictionary_dark_theme_button">Oscuro</system:String>
    <system:String x:Key="specific_style_dictionary_light_theme_button">Claro</system:String>
    <!--also used for the window title-->
    <system:String x:Key="select_language_window_window_header">Ajustes de idioma</system:String>
    <system:String x:Key="select_language_button">Idioma</system:String>
    <system:String x:Key="target_price_calculation_view_target_price_label">Precio Objetivo:</system:String>
    <!--This one is for the error message showed when handling settings file errors
        and is not used in any control-->
    <system:String x:Key="ui_settings_file_error_message">El archivo de configuarcion de la aplicación
    no esta o esta corrupto, la aplicacion y los ajustes seran reiniciados</system:String>
    <!--same as above-->
    <system:String x:Key="ui_settings_file_error_header">Error de archivo</system:String>
</ResourceDictionary>