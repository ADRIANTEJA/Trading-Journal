<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--The key is composed by the name of the file where the control using it is located 
        and the name of the control, should the string be used in more than one control it will
        be specified in a comment above it, keys are also organized alphabetically-->

    <system:String x:Key="main_window_settings_menu_header">设置</system:String>
    <system:String x:Key="main_window_switch_theme_button">主题</system:String>
    <system:String x:Key="main_window_font_size_slider">字体大小</system:String>
    <system:String x:Key="specific_style_dictionary_dark_theme_button">黑暗的</system:String>
    <system:String x:Key="specific_style_dictionary_light_theme_button">光</system:String>
    <system:String x:Key="select_language_window_window_header">语言设定</system:String>
    <system:String x:Key="select_language_button">语言</system:String>
    <!--This one is for the error message showed when handling settings file errors
        and is not used in any control-->
    <system:String x:Key="ui_settings_file_error_message">应用程序设置文件丢失或损坏，
    应用程序将重新启动并且设置将被重置</system:String>
    <!--same as above-->
    <system:String x:Key="ui_settings_file_error_header">文件错误</system:String>
</ResourceDictionary>