<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--The key is composed by the name of the file where the control using it is located 
        and the name of the control, should the string be used in more than one control it will
        be specified in a comment above it, keys are also organized alphabetically-->

    <system:String x:Key="main_window_settings_menu_header">設定</system:String>
    <system:String x:Key="main_window_switch_theme_button">テーマ</system:String>
    <system:String x:Key="main_window_font_size_slider">フォントサイズ</system:String>
    <system:String x:Key="specific_style_dictionary_dark_theme_button">暗い</system:String>
    <system:String x:Key="specific_style_dictionary_light_theme_button">ライト</system:String>
    <system:String x:Key="select_language_window_window_header">言語設定</system:String>
    <system:String x:Key="select_language_button">言語</system:String>
    <!--This one is for the error message showed when handling settings file errors
        and is not used in any control-->
    <system:String x:Key="ui_settings_file_error_message">アプリケーション設定ファイルが見つからないか破損しています。
    アプリケーションが再起動され、設定がリセットされます</system:String>
    <!--same as above-->
    <system:String x:Key="ui_settings_file_error_header">ファイルエラー</system:String>
</ResourceDictionary>