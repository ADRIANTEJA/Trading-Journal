<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--The key is composed by the name of the file where the control using it is located 
        and the name of the control, should the string be used in more than one control it will
        be specified in a comment above it, keys are also organized alphabetically-->

    <system:String x:Key="add_symbol_window_asset_type_error">アセットタイプを選択する</system:String>
    <system:String x:Key="add_symbol_window_duplicated_symbol_name_error">その資産のペアはすでに登録されている</system:String>
    <system:String x:Key="add_strategy_window_duplicated_strategy_name_error">その名前の戦略はすでに存在する</system:String>
    <!--also used in the add trade window for the asset type selector-->
    <system:String x:Key="add_trade_window_asset_type_selector_header">資産の種類</system:String>
    <system:String x:Key="add_account_window_duplicated_account_error_message">この名前ですでにアカウントが存在する</system:String>
    <!--also used for the window title-->
    <system:String x:Key="calculator_window_window_header">電卓</system:String>
    <system:String x:Key="calculator_window_target_price_button">目標価格</system:String>
    <system:String x:Key="calculator_window_calculate_button">計算する</system:String>
    <!--This one is for the error message showed when convertion of a byte[] array to
        a BitMapSource fails due to some problem with jpg image format-->
    <system:String x:Key="image_convertion_error_message">画像ファイルが無効です</system:String>
    <system:String x:Key="leverage_slider_leverage_label">てこの作用</system:String>
    <system:String x:Key="main_window_settings_menu_header">設定</system:String>
    <system:String x:Key="main_window_switch_theme_button">テーマ</system:String>
    <system:String x:Key="main_window_font_size_slider">フォントサイズ</system:String>
    <system:String x:Key="main_window_account_button">アカウント</system:String>
    <system:String x:Key="main_window_strategy_button">戦略</system:String>
    <system:String x:Key="main_window_add_trade_button">追加操作</system:String>
    <system:String x:Key="ROI_calculation_view_margin_field">投資金額</system:String>
    <system:String x:Key="ROI_calculation_view_open_price_field">入場料</system:String>
    <system:String x:Key="ROI_calculation_view_close_price_field">開始価格</system:String>
    <!--also used for the same label in TargetPriceCalculationView-->
    <system:String x:Key="ROI_calculation_view_initial_margin_label">当初証拠金:</system:String>
    <system:String x:Key="specific_style_dictionary_dark_theme_button">暗い</system:String>
    <system:String x:Key="specific_style_dictionary_light_theme_button">ライト</system:String>
    <!--also used for the window title-->
    <system:String x:Key="select_language_window_window_header">言語設定</system:String>
    <system:String x:Key="select_language_button">言語</system:String>
    <system:String x:Key="target_price_calculation_view_target_price_label">目標価格:</system:String>
    <!--This one is for the error message showed when handling settings file errors
        and is not used in any control-->
    <system:String x:Key="ui_settings_file_error_message">アプリケーション設定ファイルが見つからないか破損しています。
    アプリケーションが再起動され、設定がリセットされます</system:String>
    <!--same as above-->
    <system:String x:Key="ui_settings_file_error_header">ファイルエラー</system:String>
</ResourceDictionary>