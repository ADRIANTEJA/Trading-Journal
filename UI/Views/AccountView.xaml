<UserControl x:Class="UI.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:accountViewButtons="clr-namespace:UI.Controls.Buttons.AccountView"
             xmlns:charts="clr-namespace:UI.Controls.Charts.AccountView"
             xmlns:customScrollViewers="clr-namespace:UI.Controls.ScrollViewers.Custom"
             xmlns:liveCharts="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             x:Name="account_view"
             d:DesignHeight="1020"
             d:DesignWidth="1916"
             Background="Transparent" 
             Loaded="OnAccountViewLoadedHandler">

    <UserControl.Resources>

        <Style x:Key="performance_date_filter_listview_style" 
               TargetType="{x:Type ListView}"
               BasedOn="{StaticResource base_listview_style}">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border Height="32"
                                            Style="{StaticResource selectable_container_style}"
                                            Cursor="Hand"
                                            CornerRadius="3" 
                                            Margin="1,0,1,5">

                                        <TextBlock x:Name="performance_date_filter_textblock"
                                                   VerticalAlignment="Center"
                                                   Tag="{Binding Path=X}"
                                                   Cursor="Hand"
                                                   Text="{Binding Path=X, 
                                                          Converter={StaticResource performance_date_timeframe_converter}, 
                                                          ConverterParameter={x:Reference options_list_view}}"
                                                   Style="{StaticResource base_textblock_style}" 
                                                   MouseDown="OnSelectedDateFilterHandler"/>

                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="expand_filter_performance_by_date_control_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="filter_performance_by_date_control" 
                                           Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="320">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="collapse_filter_performance_by_date_control_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="filter_performance_by_date_control" 
                                           Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>

        <Storyboard x:Key="collapse_roi_format_options_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="roi_format_options_selector" 
                                   Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

        </Storyboard>

        <Storyboard x:Key="expand_roi_format_options_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="roi_format_options_selector" 
                           Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="103">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="5">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <accountViewButtons:AddAccountButton Margin="5"
                                                     Command="{Binding Path=MainNavigationHelper.NavigateToAddAccountCommand}"/>
                <accountViewButtons:ChangeAccountButton Grid.Column="1"
                                                        Margin="5"/>
                <accountViewButtons:DeleteAccountButton Grid.Column="2"
                                                        Margin="5"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.RowSpan="3"
                Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <ListView x:Name="accounts_listview"
                      Style="{StaticResource base_listview_style}"
                      ItemsSource="{Binding Path=Accounts}"
                      ItemContainerStyle="{StaticResource accounts_listview_item_style}"
                      Margin="10">
            </ListView>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <TextBlock Text="Account Performance"
                       Style="{StaticResource base_textblock_style}"
                       VerticalAlignment="Center"
                       FontSize="18"/>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <Grid x:Name="performance_control_bar_grid"
                  Margin="5,0,5,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="37"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <accountViewButtons:DailyPerformanceButton x:Name="daily_performance_button"
                                                           Margin="0,0,5,0"
                                                           Click="HoldTimeFrameButtonHighlightHandler"/>
                <accountViewButtons:MonthlyPerformanceButton x:Name="monthly_performance_button"
                                                             Grid.Column="1" 
                                                             Margin="0,0,5,0"
                                                             Click="HoldTimeFrameButtonHighlightHandler"/>
                <accountViewButtons:YearlyPerformanceButton x:Name="yearly_performance_button"
                                                            Grid.Column="2"
                                                            Margin="0,0,5,0"
                                                            Click="HoldTimeFrameButtonHighlightHandler"/>

                <accountViewButtons:ResetButton x:Name="reset_chart_button"
                                                Grid.Column="4" 
                                                Margin="0,0,5,0" 
                                                Click="ResetPerformanceChartButtonHandler"/>

                <Border x:Name="filter_performance_by_date_control" 
                        Grid.Column="5"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1"
                        MouseEnter="ShowFilterPerformanceByDateOptionsHandler"
                        MaxWidth="{Binding ElementName=performance_control_bar_grid}" 
                        MouseLeave="HideFilterPerformanceByDateOptionsHandler" 
                        Margin="0,5,0,5"
                        Height="32"
                        Width="125"
                        Background="{DynamicResource theme_control_wrapper_background_brush}"
                        Style="{StaticResource selector_border_style}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Filter by date"
                                       Style="{StaticResource base_textblock_style}"
                                       VerticalAlignment="Center"/>

                            <Polygon x:Name="toggle_icon"
                                     Grid.Column="1"
                                     Style="{StaticResource vector_down_icon_style}" 
                                     Margin="0,9,0,0"/>
                        </Grid>

                        <ListView x:Name="options_list_view"
                                  Grid.Row="1"
                                  Tag="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Tag}"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  IsSynchronizedWithCurrentItem="True"
                                  Style="{StaticResource performance_date_filter_listview_style}" 
                                  Loaded="OnFilterPerformanceControlLoaded"/>
                    </Grid>
                </Border>

                <charts:AccountPerformanceLineChart x:Name="account_performance_line_chart" 
                                                    Grid.ColumnSpan="6"
                                                    Grid.Row="1"
                                                    Margin="5" 
                                                    Loaded="OnAccountPerformanceChartLoadedHandler">

                    <charts:AccountPerformanceLineChart.Series>

                        <liveCharts:LineSeries Values="{Binding Path=PerformanceViewModel.AccountPerformance,
                                                                Mode=OneWay}"
                                               Style="{StaticResource account_performance_line_series_style}"/>
                    </charts:AccountPerformanceLineChart.Series>
                </charts:AccountPerformanceLineChart>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="3"
                Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <charts:StrategyUsePieChart x:Name="strategy_use_pie_chart"
                                        Series="{Binding Path=StrategyUsageSeries, Mode=OneWay}"
                                        Margin="40,40,160,40" 
                                        Loaded="OnStrategyUsePieChartLoadedHandler" 
                                        Unloaded="OnStrategyUsePieChartUnloadedHandler"/>
        </Border>
    </Grid>
</UserControl>
