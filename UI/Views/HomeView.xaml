<UserControl x:Class="UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:charts="clr-namespace:UI.Controls.Charts.AccountView"
             xmlns:liveCharts="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:customScrollViewers="clr-namespace:UI.Controls.ScrollViewers.Custom"
             xmlns:commonButtons="clr-namespace:UI.Controls.Buttons.Common"
             xmlns:calculatorButtons="clr-namespace:UI.Controls.Buttons.CalculatorWindow"
             xmlns:homeViewButtons="clr-namespace:UI.Controls.Buttons.HomeView"
             xmlns:accountViewButtons="clr-namespace:UI.Controls.Buttons.AccountView"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="1020" 
             d:DesignWidth="1916" 
             Loaded="OnHomeViewLoadedHandler">
    
    <UserControl.Resources>
        <Storyboard x:Key="show_symbol_categories_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="symbol_category_display_control" Storyboard.TargetProperty="(FrameworkElement.Width)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="960">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="hide_symbol_categories_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="symbol_category_display_control" Storyboard.TargetProperty="(FrameworkElement.Width)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="152">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="expand_crypto_filter_storyboard">
            <DoubleAnimationUsingKeyFrames  Storyboard.TargetName="crypto_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="150">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="expand_forex_filter_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="forex_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="150">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="expand_indices_filter_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="indices_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="150">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="expand_etfs_filter_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="etfs_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="150">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="expand_stocks_filter_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="stocks_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="150">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="expand_commodities_filter_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="commodities_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="150">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="collapse_crypto_filter_storyboard">
            <DoubleAnimationUsingKeyFrames  Storyboard.TargetName="crypto_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="collapse_forex_filter_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="forex_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="collapse_indices_filter_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="indices_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="collapse_etfs_filter_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="etfs_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="collapse_stocks_filter_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="stocks_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="collapse_commodities_filter_storyboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="commodities_expander" Storyboard.TargetProperty="(FrameworkElement.Height)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Style x:Key="expander_option_list_items_style" 
               TargetType="{x:Type ListView}"
               BasedOn="{StaticResource base_listview_style}">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Button Content="{Binding Path=Pair}"
                                            Style="{StaticResource text_buttons_style}" 
                                            Click="SymbolFilterButtonClickHandler"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource theme_background_brush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Path=AccountViewModel.SelectedAccount.Name}"
                           Style="{StaticResource base_textblock_style}"
                           FontSize="18"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" 
                           Margin="0,0,2,0"/>
                
                <TextBlock Grid.Column="1"
                           Text="Trades"
                           Style="{StaticResource base_textblock_style}"
                           FontSize="18"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" 
                           Margin="3,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <TextBlock Text="Performance"
                       Style="{StaticResource base_textblock_style}"
                       VerticalAlignment="Center"
                       FontSize="18"/>
        </Border>

        <Border Grid.Row="1"
                Grid.RowSpan="4"
                Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <Grid Margin="5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <commonButtons:DeleteItemButton x:Name="delete_selected_trades_button"
                                                Visibility="Hidden"
                                                Margin="1112,0,10,0" 
                                                Width="32" 
                                                Height="32" 
                                                Click="OnDeleteSelectedTradesClickHandler"/>

                <Grid Grid.Row="1" Margin="18,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="37"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="37"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <homeViewButtons:WinFilterButton x:Name="win_filter_button"
                                                     Margin="0,0,5,0" 
                                                     Click="StatusFilterButtonClickHandler"/>
                    <homeViewButtons:LossFilterButton x:Name="loss_filter_button"
                                                      Grid.Column="1"
                                                      Margin="0,0,5,0"
                                                      Click="StatusFilterButtonClickHandler"/>
                    <homeViewButtons:OpenFilterButton x:Name="open_filter_button"
                                                      Grid.Column="2"
                                                      Margin="0,0,5,0"
                                                      Click="StatusFilterButtonClickHandler"/>
    
                    <calculatorButtons:LongButton x:Name="long_filter_button"
                                                  Grid.Column="3"
                                                  Margin="0,0,5,0"
                                                  Click="SideFilterButtonClickHandler"/>
                    <calculatorButtons:ShortButton x:Name="short_filter_button" 
                                                   Grid.Column="4" 
                                                   Margin="0,0,5,0"
                                                   Click="SideFilterButtonClickHandler"/>

                    <TextBlock Grid.Column="5"
                               Text="Open Date"
                               Style="{StaticResource base_textblock_style}"
                               VerticalAlignment="Center"/>

                    <DatePicker x:Name="open_date_filter_picker"
                                Style="{StaticResource filter_date_picker_style}"
                                Grid.Column="6" 
                                SelectedDateChanged="FilterDateChangedHandler"/>

                    <TextBlock Grid.Column="7"
                               Text="Close Date"
                               Style="{StaticResource base_textblock_style}"
                               VerticalAlignment="Center"/>

                    <DatePicker x:Name="close_date_filter_picker"
                                Style="{StaticResource filter_date_picker_style}"
                                Grid.Column="8" 
                                Margin="0,0,5,0"
                                SelectedDateChanged="FilterDateChangedHandler"/>

                    <accountViewButtons:ResetButton x:Name="reset_filters_button"
                                                    Grid.Column="9"
                                                    Margin="0,0,5,0" 
                                                    Click="ResetFilterButtonClickHandler"/>
                </Grid>

                <Grid x:Name="symbol_category_display_control"
                      Grid.ColumnSpan="2"
                      Grid.RowSpan="3"
                      Panel.ZIndex="1"
                      Width="152"
                      HorizontalAlignment="Left">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="121"/>
                        <ColumnDefinition Width="121"/>
                        <ColumnDefinition Width="121"/>
                        <ColumnDefinition Width="121"/>
                        <ColumnDefinition Width="121"/>
                        <ColumnDefinition Width="121"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="select_all_checkbox"
                              Style="{StaticResource base_checkbox_style}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center" 
                              Checked="OnSelectAllCheckBoxChecked" 
                              Unchecked="OnSelectAllCheckBoxUnchecked"/>

                    <Button x:Name="expand_symbol_category_button"
                            Grid.Column="1"
                            Style="{StaticResource symbol_category_button_expand_style}"
                            Tag="1"
                            Width="90"
                            Click="ShowSymbolCategoryHandler"/>

                    <Border x:Name="crypto_expander"
                            Grid.Column="2"
                            Grid.RowSpan="2"
                            Style="{StaticResource selector_border_style}"
                            Background="{DynamicResource theme_control_wrapper_background_brush}"
                            Height="32" 
                            MouseEnter="ShowSymbolCategoryFiltersHandller"
                            MouseLeave="HideSymbolCategoryFiltersHandller" 
                            Margin="5,0,0,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Crypto"
                                           Style="{StaticResource base_textblock_style}"
                                           VerticalAlignment="Center"/>

                                <Polygon Grid.Column="1"
                                         Style="{StaticResource vector_down_icon_style}"
                                         Margin="0,9,0,0"/>
                            </Grid>

                            <ListView x:Name="crypto_list_view"
                                      Grid.Row="1"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      IsSynchronizedWithCurrentItem="True"
                                      Style="{StaticResource expander_option_list_items_style}">

                                <ListView.ItemsSource>
                                    <MultiBinding Converter="{StaticResource filter_category_converter}"
                                                  ConverterParameter="Crypto">
                                        <Binding Path="SymbolViewModel.Symbols"/>
                                        <Binding Path="SymbolViewModel.Symbols.Count"/>
                                    </MultiBinding>
                                </ListView.ItemsSource>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border x:Name="forex_expander"
                            Grid.Column="3"
                            Grid.RowSpan="2"
                            Style="{StaticResource selector_border_style}"
                            Background="{DynamicResource theme_control_wrapper_background_brush}"
                            Height="32"
                            Margin="5,0,0,0"
                            MouseEnter="ShowSymbolCategoryFiltersHandller"
                            MouseLeave="HideSymbolCategoryFiltersHandller">

                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Forex"
                                           Style="{StaticResource base_textblock_style}"
                                           VerticalAlignment="Center"/>

                                <Polygon Grid.Column="1"
                                         Style="{StaticResource vector_down_icon_style}" 
                                         Margin="0,9,0,0"/>
                            </Grid>

                            <ListView x:Name="forex_list_view"
                                      Grid.Row="1"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      Style="{StaticResource expander_option_list_items_style}">

                                <ListView.ItemsSource>
                                    <MultiBinding Converter="{StaticResource filter_category_converter}"
                                                  ConverterParameter="Forex">
                                        <Binding Path="SymbolViewModel.Symbols"/>
                                        <Binding Path="SymbolViewModel.Symbols.Count"/>
                                    </MultiBinding>
                                </ListView.ItemsSource>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border x:Name="indices_expander"
                            Grid.Column="4"
                            Grid.RowSpan="2"
                            Style="{StaticResource selector_border_style}"
                            Background="{DynamicResource theme_control_wrapper_background_brush}"
                            Height="32"
                            Margin="5,0,0,0"
                            MouseEnter="ShowSymbolCategoryFiltersHandller"
                            MouseLeave="HideSymbolCategoryFiltersHandller">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Indices"
                                           Style="{StaticResource base_textblock_style}"
                                           VerticalAlignment="Center"/>

                                <Polygon Grid.Column="1"
                                         Style="{StaticResource vector_down_icon_style}" 
                                         Margin="0,9,0,0"/>
                            </Grid>

                            <ListView x:Name="indices_list_view"
                                      Grid.Row="1"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      IsSynchronizedWithCurrentItem="True"
                                      Style="{StaticResource expander_option_list_items_style}">

                                <ListView.ItemsSource>
                                    <MultiBinding Converter="{StaticResource filter_category_converter}"
                                                  ConverterParameter="Indices">
                                        <Binding Path="SymbolViewModel.Symbols"/>
                                        <Binding Path="SymbolViewModel.Symbols.Count"/>
                                    </MultiBinding>
                                </ListView.ItemsSource>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border x:Name="etfs_expander"
                            Grid.Column="5"
                            Grid.RowSpan="2"
                            Style="{StaticResource selector_border_style}"
                            Background="{DynamicResource theme_control_wrapper_background_brush}"
                            Height="32"
                            Margin="5,0,0,0"
                            MouseEnter="ShowSymbolCategoryFiltersHandller"
                            MouseLeave="HideSymbolCategoryFiltersHandller">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="ETFs"
                                           Style="{StaticResource base_textblock_style}"
                                           VerticalAlignment="Center"/>

                                <Polygon Grid.Column="1"
                                         Style="{StaticResource vector_down_icon_style}" 
                                         Margin="0,9,0,0"/>
                            </Grid>

                            <ListView x:Name="etf_list_view"
                                      Grid.Row="1"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      IsSynchronizedWithCurrentItem="True"
                                      Style="{StaticResource expander_option_list_items_style}">

                                <ListView.ItemsSource>
                                    <MultiBinding Converter="{StaticResource filter_category_converter}"
                                                  ConverterParameter="Etf">
                                        <Binding Path="SymbolViewModel.Symbols"/>
                                        <Binding Path="SymbolViewModel.Symbols.Count"/>
                                    </MultiBinding>
                                </ListView.ItemsSource>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border x:Name="stocks_expander"
                            Grid.Column="6"
                            Grid.RowSpan="2"
                            Style="{StaticResource selector_border_style}"
                            Background="{DynamicResource theme_control_wrapper_background_brush}"
                            Height="32"
                            Margin="5,0,0,0"
                            MouseEnter="ShowSymbolCategoryFiltersHandller"
                            MouseLeave="HideSymbolCategoryFiltersHandller">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Stocks"
                                           Style="{StaticResource base_textblock_style}"
                                           VerticalAlignment="Center"/>

                                <Polygon Grid.Column="1"
                                         Style="{StaticResource vector_down_icon_style}" 
                                         Margin="0,9,0,0"/>
                            </Grid>

                            <ListView x:Name="stocks_list_view"
                                      Grid.Row="1"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      IsSynchronizedWithCurrentItem="True"
                                      Style="{StaticResource expander_option_list_items_style}">

                                <ListView.ItemsSource>
                                    <MultiBinding Converter="{StaticResource filter_category_converter}"
                                                  ConverterParameter="Stock">
                                        <Binding Path="SymbolViewModel.Symbols"/>
                                        <Binding Path="SymbolViewModel.Symbols.Count"/>
                                    </MultiBinding>
                                </ListView.ItemsSource>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border x:Name="commodities_expander"
                            Grid.Column="7"
                            Grid.RowSpan="2"
                            Style="{StaticResource selector_border_style}"
                            Background="{DynamicResource theme_control_wrapper_background_brush}"
                            Height="32"
                            Margin="5,0,0,0"
                            MouseEnter="ShowSymbolCategoryFiltersHandller" 
                            MouseLeave="HideSymbolCategoryFiltersHandller">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Commodities"
                                           Style="{StaticResource base_textblock_style}"
                                           VerticalAlignment="Center"/>

                                <Polygon Grid.Column="1"
                                         Style="{StaticResource vector_down_icon_style}" 
                                         Margin="0,9,0,0"/>
                            </Grid>

                            <ListView x:Name="commodities_list_view"
                                      Grid.Row="1"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      IsSynchronizedWithCurrentItem="True"
                                      Style="{StaticResource expander_option_list_items_style}">

                                <ListView.ItemsSource>
                                    <MultiBinding Converter="{StaticResource filter_category_converter}"
                                                  ConverterParameter="Commodities">
                                        <Binding Path="SymbolViewModel.Symbols"/>
                                        <Binding Path="SymbolViewModel.Symbols.Count"/>
                                    </MultiBinding>
                                </ListView.ItemsSource>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <ListView x:Name="trades_listview"
                          Grid.Row="2"
                          Style="{StaticResource base_listview_style}"
                          ItemContainerStyle="{StaticResource trades_listview_item_style}"
                          ItemsSource="{Binding Path=Trades}" 
                          Margin="10"/>
            </Grid>
        </Border>
        
        <Border Grid.Column="1"
                Grid.Row="1"
                Grid.RowSpan="2"
                Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <charts:AccountPerformanceLineChart x:Name="account_performance_line_chart"
                                                Margin="5"
                                                Loaded="OnAccountPerformanceChartLoaded">

                <charts:AccountPerformanceLineChart.Series>

                    <liveCharts:LineSeries Values="{Binding Path=AccountViewModel.PerformanceViewModel.AccountPerformance,
                                                            Mode=OneWay}"
                                           Style="{StaticResource account_performance_line_series_style}"/>
                </charts:AccountPerformanceLineChart.Series>
            </charts:AccountPerformanceLineChart>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="3"
                Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <TextBlock Text="Strategy Usage"
                       Style="{StaticResource base_textblock_style}"
                       VerticalAlignment="Center"
                       FontSize="18"/>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="4"
                Style="{StaticResource control_wrapper_border_style}"
                Margin="5">

            <charts:StrategyUsePieChart x:Name="strategy_use_pie_chart"
                                        Series="{Binding Path=AccountViewModel.StrategyUsageSeries, Mode=OneWay}"
                                        Margin="40,40,100,40" 
                                        Loaded="OnStrategyUsePieChartLoadedHandler" 
                                        Unloaded="OnStrategyUsePieChartUnloadedHandler"/>
        </Border>
    </Grid>
</UserControl>
